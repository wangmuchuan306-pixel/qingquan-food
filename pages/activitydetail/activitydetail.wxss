/* pages/activitydetail/activitydetail.wxss */
.body {
  width: 100%;
  height: auto;
  padding: 10rpx 30rpx;
  box-sizing: border-box;
}
.labelbox {
  width: 110rpx;
  height: 40rpx;
  border-radius: 10rpx;
  position: absolute;
  background-color: #f60;
  top: 20rpx;
  left: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: white;
  text-align: center;
  line-height: 40rpx;
}
.hbox {
  /* width: 140rpx; */
  height: 50rpx;
  padding: 0 10rpx;
  background-color: #eee;
  font-size: 26rpx;
  text-align: center;
  line-height: 50rpx;
  margin-right: 20rpx;
  border-radius: 10rpx;
}