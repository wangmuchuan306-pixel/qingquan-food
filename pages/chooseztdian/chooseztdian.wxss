/* pages/chooseztdian/chooseztdian.wxss */
.ztdianHead {
  width: 100%;
  height: auto;
  box-sizing: border-box;
  background-color: #fff;
  /* position: fixed;
  top: 0; */
}

.topBar {
  width: 100%;
  border-bottom: 1rpx solid #cdcdcd;
  position: relative;
  box-sizing: border-box;
}

.topBar view {
  width: 50%;
  box-sizing: border-box;
  height: auto;
  padding: 30rpx;
  font-size: 30rpx;
}

.choose_bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 50vw;
  border-bottom: 6rpx solid var(--theme-color);
}

.choose {
  font-weight: bold;
  color: var(--theme-color);
}

.border_bottom {
  transition: transform 0.3s ease;
  transform: translateX(0);
}

.border_bottom_act {
  transition: transform 0.3s ease;
  transform: translateX(375rpx);
}

.search {
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #fff;
}

.seaInput {
  width: 100%;
  height: 70rpx;
  box-sizing: border-box;
  background-color: #eee;
  border-radius: 35rpx;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}

.seaInput image {
  width: 28rpx;
  height: 30rpx;
  margin-right: 20rpx;
}

.seaInput input {
  font-size: 26rpx;
  color: #000;
  width: 550rpx;
}

.ztGPS {
  width: 100%;
  height: 70rpx;
  box-sizing: border-box;
}

.textGPS {
  width: 600rpx;
  height: auto;
  font-size: 26rpx;
}

.textGPS image {
  width: 26rpx;
  height: 30rpx;
  margin-right: 20rpx;
}

.refresh {
  width: 30rpx;
  height: 30rpx;
}

.ztBody {
  width: 100%;
  height: auto;
}

.ztitem {
  width: 100%;
  height: auto;
  padding: 30rpx;
  background-color: #fff;
}

.imagetag {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  margin-right: 30rpx;
}

.imagetag image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background-color: #f8f8f8;
}

.imagetag view {
  width: 90rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background-color: #f60;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
}

.item_rigth {
  width: 460rpx;
}

.item_H1 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.item_H2 {
  font-size: 26rpx;
  color: #999;
  margin: 10rpx 0rpx;
}

.item_H3 {
  font-size: 28rpx;
  color: #000;
}

.item_button{
  width: 120rpx;
  height: 60rpx;
  background-color: var(--theme-color);
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #fff;
}

.recom{
  padding: 30rpx;
  width: 100%;
  height: auto;
  box-sizing: border-box;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  /* position: sticky; */
  /* top: 0; */
}
.recomNone{
  font-size: 26rpx;
  color: #999;
  padding: 50rpx;
  text-align: center;
}