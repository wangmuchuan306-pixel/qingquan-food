<!--pages/preparegoods/preparegoods.wxml-->
<view style="width: 100%;height: 120rpx;position: fixed;top: 0;background-color: white;z-index: 999;">
  <view style="width: 690rpx;height: 80rpx;border-radius: 40rpx;background-color: #eee;margin: 20rpx 30rpx;display: flex;align-items: center;justify-content: space-between;">
    <view style="display: flex;align-items: center;">
      <icon type="search" color="#999" size="18" style="margin-left: 20rpx;" />
      <input type="text" placeholder="{{titletype==1?'搜索商品标题关键词':'搜索团长昵称/手机号'}}" style="margin-left: 20rpx;font-size: 30rpx;width: 550rpx;" placeholder-style="font-size: 30rpx;color:#999" bindinput="insearch" bindconfirm="tosearch" value="{{search}}" confirm-type="search" />
    </view>
    <image src="https://yhtapi.ehetuan.cn/yht/close.png" style="width: 40rpx;height: 40rpx;margin-right: 20rpx;" bind:tap="nosearch" wx:if="{{search}}" />
  </view>
</view>
<view style="width: 100%;height: 80rpx;position: fixed;top: 120rpx;background-color: white;display: flex;align-items: center;justify-content: space-between;z-index: 999;">
  <view class="{{titletype==1?'btitlebox':'titlebox'}}" bind:tap="changetitle" data-type="1">按商品筛选（{{count1}}）</view>
  <view class="{{titletype==2?'btitlebox':'titlebox'}}" bind:tap="changetitle" data-type="2">按团长筛选（{{count2}}）</view>
  <!-- <view style="width: 600rpx;height: 80rpx;margin-left: 30rpx;background-color: #f8f8f8;border-radius: 40rpx;display: flex;align-items: center;justify-content: space-between;">
    <view style="display: flex;align-items: center;width: 530rpx;">
      <icon type="search" size="15" style="margin-left: 20rpx;" />
      <input type="text" placeholder="输入商品标题关键词" style="font-size: 30rpx;margin-left: 10rpx;width: 100%;" placeholder-style="font-size: 30rpx;color:#999" bindinput="insearch" value="{{search}}" />
    </view>
    <image wx:if="{{search}}" src="/images/close.png" style="width: 40rpx;height: 40rpx;margin-right: 20rpx;" bind:tap="nosearch" mode=""/>
  </view>
  <icon type="search" size="20" style="margin-right: 30rpx;" bind:tap="tosearch" /> -->
</view>

<view style="height: 200rpx;"></view>
<view class='none' wx:if="{{nsgoodslist.length == 0}}">
  <image src="https://yhtapi.ehetuan.cn/summer/order_none.png" mode="widthFix"></image>
  <view style="color: #999;">还没有订单哦~</view>
</view>
<block wx:for="{{nsgoodslist}}" wx:for-index="index" wx:key="0">
  <view wx:if="{{titletype==1}}" style="width: 690rpx;margin: 30rpx;background-color: white;border-radius: 20rpx;">
    <view style="width: 630rpx;display: flex;align-items: center;border-bottom: 2rpx solid #eee;padding: 30rpx;" catch:tap="goodscheck" data-index="{{index}}">
      <radio value="" color="#003B73" checked="{{item.ischeck}}" />
      <image src="https://qiniu.0315678.cn/{{item.goodsimg}}" style="width: 140rpx;height: 140rpx;border-radius: 20rpx;margin-left: 30rpx;" mode="aspectFill" />
      <view style="width: 370rpx;height: 140rpx;margin-left: 30rpx;">
        <view style="width: 100%;display: flex;align-items: center;justify-content: space-between;">
          <view class="goodstitle">{{item.goodsname}}</view>
          <view style="font-size: 30rpx;font-weight: bold;">¥ {{item.all_pay_real_money}}</view>
        </view>
        <view style="font-size: 24rpx;color: #999;margin: 10rpx 0;">[暂无规格]</view>
        <view style="font-size: 28rpx;color: #000;">{{item.goodsprice}} x {{item.all_goodsnum}}</view>
      </view>
    </view>
    <view style="display: flex;align-items: center;padding: 30rpx;width: 630rpx;justify-content: space-between;" bind:tap="showinfo" data-index="{{index}}">
      <view style="display: flex;align-items: center;margin-left: 10rpx;width: 360rpx;">
        <block wx:for="{{item.plist.length>6?6:item.plist.length}}" wx:for-item="img" wx:for-index="imgindex">
          <image src="{{item.plist[imgindex].headimg}}" style="width: 60rpx;height: 60rpx;border-radius: 100%;margin-left: -10rpx;background-color: #eee;" mode="aspectFill" />
        </block>
      </view>
      <view style="display: flex;align-items: center;">
        <view style="font-size: 28rpx;color: #003B73;">{{item.orderuser.length}}人下单，共{{item.all_goodsnum}}单</view>
        <image src="/images/blackjiantou.png" style="height: 30rpx;margin-left: 10rpx;width: 16rpx;" />
      </view>
    </view>
  </view>
  <view wx:else style="width: 690rpx;margin: 30rpx;border-radius: 20rpx;background-color: white;">
    <view style="width: 630rpx;display: flex;align-items: center;justify-content: space-between;padding: 30rpx;">
      <view style="display: flex;align-items: center;">
        <radio value="" color="#003B73" checked="{{item.parentcheck}}" bind:tap="parentcheck" data-index="{{index}}" />
        <image src="{{item.headimg}}" style="width: 100rpx;height: 100rpx;border-radius: 100%;margin:0 30rpx;" mode="aspectFill" />
        <view>
          <view style="width: 240rpx;font-weight: bold;font-size: 28rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;">{{item.nickname}}</view>
          <view style="font-size: 24rpx;color: #999;width: 240rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;margin-top: 4rpx;">{{item.sq_name}}</view>
          <view style="font-size: 24rpx;color: #666;">共{{item.ordergoods.length}}种 共{{item.goodsnum}}件</view>
        </view>
      </view>
      <view style="width: 120rpx;height: 60rpx;border-radius: 30rpx;background-color: #003B73;display: flex;align-items: center;justify-content: center;" bind:tap="callphone" data-phone="{{item.phone}}">
        <!-- <image src="/images/phone.png" style="width: 30rpx;height: 30rpx;" mode="" /> -->
        <view style="font-size: 28rpx;color: white;">联系</view>
      </view>
      <!-- <image src="{{url}}/yht/phone.png" style="width: 30rpx;height: 30rpx;" bind:tap="callphone" data-phone="{{}}" mode="" /> -->
      <!-- <view style="font-size: 30rpx;font-weight: bold;">¥{{item.all_user_money}}</view> -->
    </view>
    <view style="width: 630rpx;height: 2rpx;background-color: #eee;margin: 0 auto;margin-bottom: 30rpx;"></view>
    <view wx:for="{{item.ordergoods}}" wx:for-item="goods" wx:for-index="gindex" style="padding: 30rpx;padding-top: 0;" catch:tap="goodscheck" data-index="{{index}}" data-gindex="{{gindex}}">
      <view style="width: 630rpx;display: flex;align-items: center;">
        <radio value="" color="#003B73" checked="{{goods.ischeck}}" />
        <image src="https://qiniu.0315678.cn/{{goods.goodsimg}}" style="width: 140rpx;height: 140rpx;border-radius: 20rpx;margin-left: 30rpx;" mode="aspectFill" />
        <view style="width: 370rpx;height: 140rpx;margin-left: 30rpx;">
          <view style="width: 100%;display: flex;align-items: center;justify-content: space-between;">
            <view class="goodstitle">{{goods.goodsname}}</view>
            <view style="font-size: 30rpx;font-weight: bold;">¥ {{goods.order_total_money}}</view>
          </view>
          <view style="font-size: 24rpx;color: #999;margin: 10rpx 0;">[暂无规格]</view>
          <view style="font-size: 28rpx;color: #000;">{{goods.goodsprice}} x {{goods.goodsnum}}</view>
        </view>
      </view>
      <view style="width: 570rpx;height: 60rpx;border-radius: 30rpx;background-color: #f4f7fc;margin-top:30rpx;padding: 0 30rpx;font-size: 24rpx;color: #999;line-height: 60rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" wx:if="{{goods.orderremark}}">备注：{{goods.orderremark}}</view>
    </view>

  </view>
</block>
<view style="height: 180rpx;"></view>
<view style="width: 100%;height: 180rpx;background-color: white;position: fixed;bottom: 0;display: flex;">
  <view class="dbox" bind:tap="plsend">批量发货</view>
</view>
<van-popup show="{{ show }}" round position="bottom" bind:close="onClose" safe-area-inset-bottom="{{false}}" z-index="999">
  <view style="width: 690rpx;margin: 30rpx;display: flex;align-items: center;justify-content: space-between;">
    <view style="display: flex;align-items: center;">
      <view class="istitle" bind:tap="changetype" data-type="1">自提订单{{count[0]}}</view>
    </view>
    <image src="https://yht.0315678.cn/yht/bigblackx.png" style="width: 28rpx;height: 28rpx;" bind:tap="onClose" />
  </view>
  <scroll-view style="width: 100%;height: 800rpx;" scroll-y bindscrolltolower="scrolltolower">
    <view class='none' wx:if="{{nsgoodslist[gindex].orderuser.length == 0}}">
      <image src="https://yhtapi.ehetuan.cn/summer/order_none.png" mode="widthFix"></image>
      <view style="color: #999;">还没有订单哦~</view>
    </view>
    <view style="width: 690rpx;padding: 30rpx;display: flex;align-items: center;justify-content: space-between;" wx:for="{{nsgoodslist[gindex].orderuser}}">
      <view style="display: flex;align-items: center;" bind:tap="chooseorder" data-index="{{index}}">
        <radio value="" color="#003B73" checked="{{item.ischecked}}" />
        <image src="{{item.headimg}}" style="width: 140rpx;height: 140rpx;border-radius: 100%;background-color: #eee;margin-left: 10rpx;" mode="aspectFill" />
        <view style="margin-left: 30rpx;">
          <view style="display: flex;align-items: center;justify-content: space-between;width: 450rpx;">
            <view style="font-size: 30rpx;font-weight: bold;">{{item.nickname}}</view>
            <image src="/images/bphone.png" style="width: 30rpx;height: 30rpx;" catch:tap="callphone" mode="" data-phone="{{item.p_phone}}" />
          </view>
          <view style="display: flex;align-items: center;justify-content: space-between;width: 450rpx;margin-top: 10rpx;">
            <view>
              <view style="font-size: 24rpx;color: #999;margin-top: 10rpx;">{{item.pay_time}}</view>
              <view style="font-size: 28rpx;margin-top: 10rpx;">¥ {{item.goodsprice}} x {{item.goodsnum}}</view>
            </view>
            <view class="deliverybox" catch:tap="updateOrderStatus" data-index="{{index}}">发货</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view style="width: 690rpx;margin: 30rpx 30rpx 50rpx 30rpx;display: flex;align-items: center;justify-content: space-between;">
    <view style="display: flex;align-items: center;" bind:tap="chooseall">
      <radio value="" color="#003B73" checked="{{allchecked}}" />
      <view style="font-size: 30rpx;color: #003B73;margin-left: 10rpx;">全选</view>
    </view>
    <view class="alldelivery" style="background-color: {{cansend?'#003B73':''}};" bindtap="{{cansend?'updateOrderStatus':''}}" data-index="allsendorder">批量发货</view>
  </view>
</van-popup>
<van-popup show="{{ sendgoods }}" bind:close="sendcancel" round="true" position="bottom" closeable="true" z-index="999">
  <view style="width: 690rpx;margin: 30rpx;display: flex;align-items: center;justify-content: space-between;padding-bottom: 30rpx;">
    <view style="font-size: 36rpx;font-weight: bold;">选择发货方式</view>
  </view>
  <view style="display: flex;align-items: center;justify-content: space-between;width: 690rpx;margin: 30rpx;padding-bottom: 30rpx;" bindtap="cstype" data-type="1">
    <view>
      <view style="font-size: 30rpx;font-weight: bold;color: {{send_type==1?'#003B73':''}};">商家自行配送</view>
      <view style="font-size: 24rpx;color: {{send_type==1?'':'#999'}};margin-top: 10rpx;">供应商自有配送团队，配送给团长</view>
    </view>
    <radio color="#003B73" checked="{{send_type==1}}" />
  </view>
  <view style="display: flex;align-items: center;justify-content: space-between;width: 690rpx;margin: 30rpx;border-bottom: 2rpx solid #eee;padding-bottom: 80rpx;" bindtap="cstype" data-type="3">
    <view>
      <view style="font-size: 30rpx;font-weight: bold;color: {{send_type==3?'#003B73':''}};">交由平台配送</view>
      <view style="font-size: 24rpx;color: {{send_type==3?'':'#999'}};margin-top: 10rpx;">艺荷团镖师上门揽件，配送给团长</view>
    </view>
    <radio color="#003B73" checked="{{send_type==3}}" />
  </view>
  <view class="csbtn" style="background-color: {{send_type?'#003B73':'#ccc'}};" bindtap="{{send_type?'choosetype':''}}">立即发货</view>
</van-popup>