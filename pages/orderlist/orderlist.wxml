<!--pages/orderlist/orderlist.wxml-->
<page-meta page-style="{{ show ? 'overflow: hidden;' : '' }}" />
<view data-theme="{{theme}}" id="page" style="width: 100%;min-height: 100vh;">
  <view style="display: flex;align-items: center;justify-content: space-between;width: 690rpx;background-color: #fff;padding: 30rpx;position: fixed;top: 0;z-index: 2;">
    <view class="changetype {{order_status==0?'active':''}}" bind:tap="changetype" data-type="0">全部</view>
    <view class="changetype {{order_status==1?'active':''}}" bind:tap="changetype" data-type="1">待发货</view>
    <view class="changetype {{order_status==2?'active':''}}" bind:tap="changetype" data-type="2">待收货</view>
    <!-- <view class="changetype {{order_status==100?'active':''}}" bind:tap="changetype" data-type="100">待提货</view> -->
    <view class="changetype {{order_status==9?'active':''}}" bind:tap="changetype" data-type="9">已退款</view>
    <view class="changetype {{order_status==4?'active':''}}" bind:tap="changetype" data-type="4">已完成</view>
  </view>
  <view style="height: 100rpx;"></view>
  <view wx:if="{{isShow}}" class="{{chooseSize?'indexFixed':''}}">
    <view class="tab-content">
      <block wx:for="{{order}}" wx:for-item="list" wx:key="k">
        <view class="list_main" data-theme="{{theme}}">
          <view class="storeInfo" data-theme="{{theme}}">
            <view class="storeInfo_left">
              <image class="avatar" src="{{url}}/summer/dianpu2.png?{{veision}}"></image>
              <view class="storeName" data-theme="{{theme}}">{{list.store_name}}</view>
            </view>
            <view class="storeInfo_right">
              <view class="storeName1">
                <text wx:if="{{list.order_status == 2}}">{{list.ztdian_type==2?'待收货':'待自提点接货'}}</text>
                <text wx:else>{{list.sta_txt}}</text>
              </view>
            </view>
          </view>
          <view class="list_center" data-theme="{{theme}}" wx:for="{{list.ordergoods}}">
            <!-- 商品图 -->
            <view style="position: relative;">
              <image src="{{item.goodsimg}}" style="width: 168rpx;height: 168rpx;border-radius: 16rpx;" bindtap="goOrderInfo" data-id="{{list.orderno}}" mode="aspectFill" />
              <image wx:if="{{list.group_id !=0}}" src="{{url}}/summer/beijingtu1.png?{{veision}}" style="width: 120rpx;height: 120rpx;position: absolute;left: -10rpx;top: -10rpx;"></image>
              <view wx:if="{{list.group_id !=0}}" style="font-size: 24rpx;color: #fff;position: absolute;top: 6rpx;left: 6rpx;transform: rotate(315deg);">拼团</view>
            </view>

            <view class="list_center_right" bindtap="goOrderInfo" data-id="{{list.orderno}}">
              <view data-theme="{{theme}}">{{item.goodsname}} {{item.smalltitle}}</view>
              <view>{{item.sku_id == 0?'[规格暂无]':'['+item.sku1 +' & '+item.sku2+']'}}</view>
              <view>
                <text>￥{{item.goodsprice}}</text>
                <text class="num">x{{item.goodsnum}}</text>
              </view>
            </view>
          </view>
          <!-- 快递员&&手机号结束 -->
          <view class="list_bottom">
            <view class="list_bottom_top">
              <view data-theme="{{theme}}">实付款 <text style="color:#f60;">￥{{list.pay_real_money}}</text></view>
              <view>[含运费{{list.deliver_money}}元/{{list.ztdian_type==1?'线下自提':'同城配送'}}]
              </view>
            </view>
            <view class="list_bottom1">
              <view wx:if="{{list.order_status==4}}" bind:tap="tobuygoods" data-id="{{list.ordergoods[0].goodsid}}" class="flex1" style="width: 160rpx;height: 60rpx;color: #fff;background-color: #015637;border-radius: 30rpx;font-size: 24rpx;margin-right: 20rpx;">再来一单</view>
              <view class="view1" style="margin-right: 0;" bindtap="call_phone" data-phone="{{list.store_phone}}">联系客服</view>
              <view class="fukuan" wx:if="{{list.order_status==1}}" bind:tap="cancelOrderfy" data-id="{{list.orderno}}" data-index="{{index}}">我要退款</view>
              <block wx:else>
                <view class="fukuan " wx:if="{{list.order_status == 100}}" bindtap="querentihuo" data-id="{{list.orderno}}" data-index="{{index}}">确认提货</view>
                <view class="fukuan" wx:if="{{list.order_status == 2&&list.ztdian_type==2}}" bindtap="querenshouhuo" data-id="{{list.orderno}}" data-index="{{index}}">确认收货</view>
              </block>
              <!-- <block wx:if="{{list.ztdian_type==1}}">
              </block>
              <block wx:else>
              </block> -->
              <!-- <view class="fukuan {{list.order_status<=2?'fukuan1':''}}" wx:if="{{list.order_status==3&&list.deliver_type==1 }}" bindtap="querenshouhuo" data-id="{{list.orderno}}" data-index="{{index}}">确认收货</view>
              <view class="fukuan" style="background:#ccc;" wx:if="{{list.order_status<=2&&list.deliver_type==1 }}" data-index="{{index}}">确认收货</view>
              <view class="fukuan {{list.order_status<=2?'fukuan1':''}}" wx:if="{{list.order_status==100 }}" bindtap="querentihuo" data-id="{{list.orderno}}" data-index="{{index}}">确认提货</view>
              <view class="fukuan {{list.order_status<2?'fukuan1':''}}" wx:if="{{list.order_status<=3&&list.deliver_type==2}}" bindtap="querenshouhuo" data-id="{{list.orderno}}" data-index="{{index}}">确认收货</view>
              <view class="fukuan {{list.order_status==1?'fukuan1':''}}" wx:if="{{list.order_status<=3&&list.deliver_type==3}}" bindtap="querenshouhuo" data-id="{{list.orderno}}" data-index="{{index}}">确认使用</view>
              <view class="fukuan" wx:if="{{list.order_status>=4&&list.order_status==9&&list.iscomment==0}}" bindtap="delorder" data-id="{{list.orderno}}">删除订单</view>
              <button open-type="share" wx:if="{{list.order_status>=4&&list.iscomment==1}}" data-id="3" data-id="{{list.orderno}}" data-gid="{{list.goodsid}}" data-title="{{list.goodsname}}" data-coverimg="{{list.goodsimg}}">立即分享</button> -->
            </view>
          </view>
        </view>
      </block>
      <view class='end' wx:if="{{count!=0  && dixian!=''&&loading}}">
        {{dixian}}
      </view>
      <!-- 下拉刷新&加载动画 -->
      <!-- <jloading wx:if="{{!loading}}"></jloading> -->
      <!-- 上拉加载 -->
      <!-- <view wx:if="{{listmore}}" class="end">
        <van-loading size="24px">加载中...</van-loading>
      </view> -->
      <view class='none' wx:if="{{count==0}}">
        <image src="{{url}}/summer/order_none.png?{{veision}}" mode="widthFix"></image>
        <view>还没有订单哦~</view>
      </view>
    </view>
    <!-- 回到顶部 -->
    <image src='{{url}}/summer/goUp2.png?{{veision}}' bindtap="goTop" hidden='{{!visual}}' class="goTop {{animation}}"></image>
    <!--屏幕背景变暗的背景  -->
    <view class="commodity_screen" bindtap="hideModal" wx:if="{{chooseSize}}"></view>
    <!-- 删除订单弹窗 -->
    <view class="delete {{isIpx?'isIpxstyle':''}}" style="background:#ffffff;" wx:if="{{chooseSize&&order_statu==4}}" animation='{{animationData}}'>
      <image src="{{url}}/summer/none_order.png?{{veision}}"></image>
      <view>是否删除该订单，删除后不可找回。</view>
      <button bindtap="delOrder" data-="">立即删除</button>
    </view>
  </view>
  <view style="height: 100rpx;"></view>
</view>
<van-popup show="{{ show }}" round position="bottom" bind:close="onClose" closeable safe-area-inset-bottom="{{false}}">
  <view style="font-size: 36rpx;font-weight: bold;margin: 30rpx;">确认收货</view>
  <view style="font-size: 26rpx;color: #999;margin: 30rpx;">友情提示</view>
  <view style="font-size: 26rpx;margin: 30rpx;">请将此页面向商家出示或直接点击确认收货</view>
  <view style="margin: 0 auto;display: flex;align-items: center;justify-content: space-between;width: 690rpx;">
    <view class="nextbtn" style="background-color: {{havelast?'#333':'#eee'}};" bind:tap="lastcode">
      <image src="https://qqspapi.0315678.cn/summer/back-pre.png" style="width: 40rpx;height: 40rpx;" />
    </view>
    <image src="{{order[showindex].qrcode}}" style="width: 400rpx;height: 400rpx;" />
    <view class="nextbtn" style="background-color: {{havenext?'#333':'#eee'}};" bind:tap="nextcode">
      <image src="https://qqspapi.0315678.cn/summer/back-pre.png" style="width: 40rpx;transform: rotate(180deg);height: 40rpx;" />
    </view>
  </view>
  <view style="font-size: 26rpx;color: #999;margin: 30rpx;">本单商品信息</view>
  <view class="list_center" style="margin: 30rpx;padding-top: 0;" data-theme="{{theme}}">
    <!-- 商品图 -->
    <image src="{{order[showindex].ordergoods[0].goodsimg}}" style="width: 168rpx;height: 168rpx;" mode="aspectFill" />
    <view class="list_center_right" bindtap="goOrderInfo" data-id="{{list.orderno}}">
      <view data-theme="{{theme}}">{{order[showindex].ordergoods[0].goodsname}} {{order[showindex].ordergoods[0].smalltitle}}</view>
      <view>{{order[showindex].ordergoods[0].sku_id == 0?'[规格暂无]':'['+order[showindex].ordergoods[0].sku1 +' & '+order[showindex].ordergoods[0].sku2+']'}}</view>
      <view>
        <text>￥{{order[showindex].ordergoods[0].goodsprice}}</text>
        <text class="num">x{{order[showindex].ordergoods[0].goodsnum}}</text>
      </view>
    </view>
  </view>
  <view style="width: 690rpx;height: 100rpx;margin: 30rpx;background-color: #f60;border-radius: 20rpx;font-size: 30rpx;font-weight: bold;color: white;text-align: center;line-height: 100rpx;" bind:tap="onClose">确定</view>
</van-popup>