<view data-theme="{{theme}}" id="page" style="width: 100%;min-height: 100vh;">
  <view style="width: 100%;height: 30rpx;opacity: 0;"></view>
  <view class="main {{showModalStatus?'indexFixed':''}} {{isIpx?'main_bottom':''}}">
    <!-- 头部余额部分 -->
    <view class="header" data-theme="{{theme}}">
      <view class="header_top">账户余额</view>
      <view style="display: flex;align-items: center;justify-content: space-between;">
        <view class="header_center">{{info?info.all_money:0.00}}</view>
        <!-- <view>
          <button wx:if="{{isphone!=1}}" class='tixian1' style="width: 128rpx;height: 60rpx;line-height: 60rpx;font-size: 30rpx;margin-top: 0;" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">提现</button>
          <button wx:else class="tixian1" bindtap="showModal" style="width: 128rpx;height: 60rpx;line-height: 60rpx;font-size: 30rpx;margin-top: 0;">提现</button>
        </view> -->
      </view>
      <!-- <view class="freeze" wx:if="{{info.lockmoney != 0}}" data-theme="{{theme}}">其中包含<text>{{info.lockmoney}}</text>元冻结资金（可用于余额支付，不可提现）</view> -->
      <!-- <view class="header_bottom">
        <image src="{{url}}/summer/qianbaotu1.png?{{veision}}"></image>
        <view>提现免手续费，预计1-3工作日内审核到账</view>
      </view> -->
      <view class="header_footer" data-theme="{{theme}}">
        <view class="footer-list" data-theme="{{theme}}">
          <view data-theme="{{theme}}">{{info?info.total_save_money:0.00}}</view>
          <view>累计帮您省</view>
        </view>
        <view class="footer-list" data-theme="{{theme}}">
          <view data-theme="{{theme}}">{{info?info.total_prize_money:0.00}}</view>
          <view>累计奖励金</view>
        </view>
        <view class="footer-list" data-theme="{{theme}}">
          <view data-theme="{{theme}}">{{info?info.total_fc:0.00}}</view>
          <view>累计分佣</view>
        </view>
      </view>
    </view>
    <!-- 列表部分 -->
    <view id="affix"></view>
    <view class="list_main">
      <block wx:for="{{walletsList}}" wx:for-item="list" wx:key="k" wx:for-index='index' wx:if="{{walletcount!=0 &&loading}}">
        <view class="list_title {{menuFixed ? 'fixed': ''}}" id="affix" wx:if="{{walletsList[index].year!=walletsList[index-1].year}}" data-theme="{{theme}}">{{list.left_year}}</view>
        <view class="list_main_list1" data-theme="{{theme}}">
          <view class="list_main_list">
            <view class="list_main_list_left">
              <view data-theme="{{theme}}">{{list.day}}</view>
              <view>{{list.hour_min}}</view>
            </view>
            <view class="list_main_list_right">
              <view class="list_top">
                <text>{{list.log_title}}</text>
                <text>{{list.money}}</text>
              </view>
              <view class="list_bottom">{{list.txt}}</view>
              <!-- <view class="list_bottom">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</view> -->
            </view>
          </view>
        </view>

      </block>
      <!-- 下拉刷新&加载动画 -->
      <jloading wx:if="{{!loading}}"></jloading>
      <!-- 上拉加载 -->
      <view wx:if="{{listmore}}" class="end">
        <van-loading size="24px">加载中...</van-loading>
      </view>
      <view class="dibu1" wx:if="{{walletcount==0&&loading}}">暂时没有数据~</view>
      <view class="dibu1" wx:if="{{walletcount!=0&&comment_end&&loading}}">一不小心就滑到底了~</view>
    </view>
    <!-- <view class="dibu" data-theme="{{theme}}">
    <button wx:if="{{isphone!=1}}" class='tixian1' open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">扫码支付</button>
    <button wx:else class="tixian1" bindtap="BalancePayment">扫码支付</button>
  </view> -->


    <!-- 回到顶部 -->
    <image src='{{url}}/summer/goUp2.png?{{veision}}' class="goTop {{isIpx?'goTop-iphonex-button':''}}" bindtap="goTop" hidden='{{!floorstatus}}'></image>

    <!-- 底部弹窗 -->
    <view class="dialog_screen" bindtap="hideModal" wx:if="{{showModalStatus}}"></view>
    <van-popup show="{{ share }}" round position="bottom" custom-style="height: 52vh" bind:close="onClose">
      <!-- <view animation="{{animationData}}" class="dialog_attr_box {{isIpx?'dialog_attr_box_isIpxstyle':''}}" wx:if="{{showModalStatus}}"> -->
      <view class="withdrawal_title">
        <view class="withdrawal_title_title">
          <view>发起提现</view>
          <view wx:if="{{money==''||!disabled}}">余额提现到微信钱包，1-3个工作日内审核到账</view>
          <view wx:if="{{disabled&&smallten==1&&money!=''}}" style="color:red;font-weight:600;">提现金额最低{{info.small_money_tx}}元，本次最高可提现 {{info?info.blances:0.00}}元</view>
          <view wx:if="{{disabled&&smallten==2&&money!=''}}" style="color:red;font-weight:600;">输入金额超出可提现余额 {{info?info.blances:0.00}}元!</view>
        </view>
        <image bindtap="onClose" src="{{url}}/summer/close02.png?{{veision}}"></image>
      </view>
      <view class="import">
        <view>￥</view>
        <input hidden="{{!share}}" value="{{money}}" type="number" placeholder="请输入提现金额" placeholder-class="input_place" bindinput="getmoney" cursor-spacing="160" focus='{true}'></input>
      </view>
      <view class="import_bottom">
        <view>账户余额 {{info?info.blance:0.00}}元，最高可提现 {{info?info.blances:0.00}}元</view>
        <view bindtap="allDrawal">全部提现</view>
      </view>
      <view class="bottomfreeze" wx:if="{{info.lockmoney != 0}}">您有<text>{{info.lockmoney}}</text>元现金已冻结，仅可用于余额支付，不可提现</view>
      <button class="tixian" disabled="{{disabled}}" bindtap="walletDrawal">确认提现</button>
      <!-- </view> -->
    </van-popup>
  </view>
</view>