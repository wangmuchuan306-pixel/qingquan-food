<!--pages/login/login.wxml-->
<!--pages/login/login.wxml-->
<view class="img" style="margin-top: 200rpx;">
  <image src="/images/logo.jpg" style="width: 300rpx;height: 300rpx;border-radius: 100%;" mode="aspectFill"></image>
</view>
<view style="font-size: 30rpx;display: flex;align-items: center;justify-content: center;margin: 30rpx;">登录冀唐清泉小程序</view>
<view class="login" bindtap="getUserProfile">授权登录</view>
<!-- <view class="login notl">微信授权登录</view> -->
<view class="nologin" bindtap="goback">暂不登录</view>
<van-popup show="{{loginShow}}" round custom-style="z-index: 999;" position="bottom" bind:click-overlay="closePopup">
  <view style="width: 100%;box-sizing: border-box;background-color: #fff;padding: 30rpx;">
    <view class="flex3" style="margin-bottom: 20rpx;">
      <view style="font-size: 36rpx;">登录冀唐清泉小程序</view>
      <image src="/images/del.png" bind:tap="closePopup" style="width: 40rpx;height: 40rpx;" mode="" />
    </view>
    <view style="font-size: 26rpx;color: #999;margin-bottom: 30rpx;">首次登录请先完善您的资料</view>
    <view class="flex3" style="padding: 30rpx 0rpx;border-bottom: 1rpx solid #eee;">
      <view class="flex1" style="flex-direction: column;">
        <image src="{{tmpheadimg ? tmpheadimg : '/images/noimg.png'}}" style="width: 100rpx;height: 100rpx;border-radius: 100%;" mode="aspectFill" />
        <view class="flex1" style="width: 80rpx;height: 40rpx;background-color: #003B73;color: #fff;font-size: 24rpx;margin-top: -30rpx;border-radius: 20rpx;"><text>上传</text></view>
      </view>
      <view class="flex2">
        <text style="font-size: 28rpx;margin-right: 10rpx;">获取微信头像</text>
        <image src="/images/blackjiantou.png" style="width: 16rpx;height: 24rpx;" mode="" />
        <button open-type="chooseAvatar" bindchooseavatar="chooseloge" style="width: 200rpx;height: 40rpx;position: absolute;border: none;" plain></button>
      </view>
    </view>
    <view class="flex3" style="padding: 30rpx 0rpx;border-bottom: 1rpx solid #eee;">
      <view class="flex2">
        <text style="font-size: 30rpx;color: #333;margin-right: 20rpx;">您的昵称</text>
        <input type="nickname" focus="{{name}}" bindinput="inickname" value="{{p_username}}" style="width: 320rpx;" placeholder="请填写您的昵称" placeholder-style="font-size: 30rpx;color: #ccc;" />
      </view>
      <view class="flex2">
        <text style="font-size: 28rpx;margin-right: 10rpx;">获取微信昵称</text>
        <image src="/images/blackjiantou.png" style="width: 16rpx;height: 24rpx;" mode="" />
        <button bind:tap="inputsdf" style="width: 200rpx;height: 40rpx;position: absolute;border: none;" plain></button>
      </view>
    </view>
    <view class="flex3" style="padding: 30rpx 0rpx;border-bottom: 1rpx solid #eee;">
      <view class="flex2">
        <text style="font-size: 30rpx;color: #333;margin-right: 20rpx;">手机号码</text>
        <input type="number" style="width: 320rpx;" bindinput="inphone" value="{{p_phone}}" maxlength="11" placeholder="请填写您的手机号码" placeholder-style="font-size: 30rpx;color: #ccc;" />
      </view>
      <view class="flex2">
        <text style="font-size: 28rpx;margin-right: 10rpx;">授权手机号码</text>
        <image src="/images/blackjiantou.png" style="width: 16rpx;height: 24rpx;" mode="" />
        <button open-type="getPhoneNumber" bindgetphonenumber="getphone" style="width: 200rpx;height: 40rpx;position: absolute;border: none;" plain></button>
      </view>
    </view>
    <view class="flex1" bind:tap="setwxinfo" style="width: 100%;height: 100rpx;border-radius: 20rpx;background-color: #003B73;font-size: 30rpx;font-weight: bold;color: #fff;margin-top: 30rpx;"><text>立即登录</text></view>
    <!-- <view bind:tap="closePopup" style="color: #003B73;font-size: 28rpx;margin-top: 50rpx;text-align: center;">暂不登录</view> -->
  </view>
</van-popup>
