/* pages/login/login.wxss */
page {
  background-color: #fff;
}

.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
}

.logo-wrapper {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 59, 115, 0.15);
}

.logo-img {
  width: 100%;
  height: 100%;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #003B73;
  margin-top: 40rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.login-section {
  width: 100%;
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.login-btn.loading {
  background: linear-gradient(135deg, #ccc 0%, #999 100%);
  box-shadow: none;
}

.login-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
}

.login-btn-content text {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  align-items: center;
  justify-content: center;
}

.loading-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-content text {
  font-size: 28rpx;
  color: #fff;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.skip-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 40rpx;
  padding: 20rpx 40rpx;
}

.skip-btn text {
  font-size: 28rpx;
  color: #666;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

.policy-section {
  position: fixed;
  bottom: 80rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.policy-text {
  font-size: 24rpx;
  color: #999;
}

.policy-link {
  font-size: 24rpx;
  color: #003B73;
  margin: 0 4rpx;
}

.flex1 {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex2 {
  display: flex;
  align-items: center;
}

.flex3 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.close-btn {
  padding: 10rpx;
}

.info-section {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #003B73;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.step-num.completed {
  background-color: #07c160;
}

.info-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 60rpx;
}

.avatar-upload {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.upload-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-text {
  font-size: 22rpx;
  color: #fff;
}

.nickname-input,
.phone-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.nickname-input.has-value,
.phone-input.has-value {
  border-color: #07c160;
  background-color: #f0fff4;
}

.auto-get {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.auto-get-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

.auto-btn {
  font-size: 24rpx;
  color: #003B73;
  padding: 12rpx 24rpx;
  border: 2rpx solid #003B73;
  border-radius: 30rpx;
  background-color: transparent;
  line-height: 1.5;
}

.auto-btn.primary {
  background-color: #003B73;
  color: #fff;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background-color: #ccc;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 40rpx;
  transition: all 0.3s ease;
}

.submit-btn.active {
  background: linear-gradient(135deg, #003B73 0%, #002a57 100%);
  box-shadow: 0 10rpx 30rpx rgba(0, 59, 115, 0.3);
}

.submit-btn text {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

.submit-arrow {
  width: 32rpx;
  height: 32rpx;
}

.skip-link {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 30rpx;
  padding: 20rpx;
}