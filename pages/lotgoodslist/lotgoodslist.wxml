<view style="width: 100%;display: flex;background-color: white;">
  <!-- 二级分类 -->
  <scroll-view scroll-y style="width: 180rpx;height: {{scrollheight}}px;background-color: #f8f8f8;">
    <view class="catwobox" wx:for="{{catelist}}" wx:key="id" bind:tap="chaonecat" data-index="{{index}}">
      <view class="inbox" style="{{index==catindex?'background-color: #005832;color: white;':''}}">{{item.cate_name}}</view>
    </view>
  </scroll-view>
  <view style="background-color: white;width: 570rpx;">
    <view style="width: 510rpx;display: flex;align-items: center;justify-content: space-between;height: 80rpx;margin:0 auto;">
      <view style="font-size: 24rpx;{{paixuindex==0?'font-weight: bold;':'color: #666;'}}" bind:tap="changepaixu" data-type="0">默认排序</view>
      <view style="font-size: 24rpx;{{paixuindex==1?'font-weight: bold;':'color: #666;'}}" bind:tap="changepaixu" data-type="1">销量最高</view>
      <view style="font-size: 24rpx;{{paixuindex==3?'font-weight: bold;':'color: #666;'}}" bind:tap="changepaixu" data-type="3">最新上架</view>
    </view>
    <!-- 一级分类 -->
    <scroll-view scroll-x style="width: 540rpx;margin-left: 30rpx;margin-bottom: 30rpx;">
      <view style="width: max-content;display: flex;align-items: center;">
        <view class="{{ctwoindex==index?'ispaixu':'paixubox'}}" wx:for="{{catelist[catindex].list}}" wx:key="id" bind:tap="chatwocat" data-index="{{index}}">{{item.cate_name}}</view>
        <!-- <view style="width: 180rpx;display: flex;align-items: center;justify-content: center;">
          <view style="text-align: center;">
            <image src="{{item.imgpath}}" style="width: 100rpx;height: 100rpx;border-radius: 100%;box-sizing: border-box;{{catindex==index?'border:4rpx solid #005832;':''}}" mode="aspectFill" />
            <view style="font-size: 24rpx;{{catindex==index?'font-weight: bold;color: #005832;':''}}">{{item.small_title}}</view>
          </view>
        </view> -->
      </view>
    </scroll-view>
    <scroll-view scroll-y style="width: 570rpx;height: {{scrollheight-170*pixelRatio}}px;" bindscrolltolower="scrolltolower">
      <!-- 商品列表 -->
      <view style="margin: 30rpx;margin-top: 0;width: 510rpx;display: flex;align-items: center;" wx:for="{{goodslist}}" wx:key="goods_id" bind:tap="togoods" data-id="{{item.goods_id}}">
        <view style="width: 140rpx;height: 140rpx;position: relative;">
          <image src="{{item.goods_img}}" style="width: 140rpx;height: 140rpx;border-radius: 20rpx;" mode="aspectFill" />
          <!-- <view class="hbox" style="height: 40rpx;font-size: 24rpx;line-height: 40rpx;position: absolute;bottom: 0;left: 0;width: 120rpx;">
            <text wx:if="{{item.zttype==12}}">配送/自提</text>
            <text wx:if="{{item.zttype==1}}">仅自提</text>
            <text wx:if="{{item.zttype==2}}">仅配送</text>
          </view> -->
        </view>
        <view style="width: 340rpx;margin-left: 30rpx;">
          <view style="width: 100%;font-size: 28rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;">{{item.goods_name}}</view>
          <!-- <view style="display: flex;align-items: center;margin: 10rpx auto;">
            <view class="hbox" style="height: 120rpx;height: 40rpx;font-size: 24rpx;line-height: 40rpx;">
              <text wx:if="{{item.zttype==12}}">配送/自提</text>
              <text wx:if="{{item.zttype==1}}">仅自提</text>
              <text wx:if="{{item.zttype==2}}">仅配送</text>
            </view>
            <view class="hbox" style="height: 120rpx;height: 40rpx;font-size: 24rpx;line-height: 40rpx;">{{item.xg_num==0?'不限购':'限购 '+item.xg_num}}</view>
          </view> -->
          <view style="font-size: 24rpx;color: #999;font-weight: normal;margin: 10rpx auto;width: 100%;">
            <text>已售 {{item.volume+1000}}</text>
            / 库存 {{item.goodsstock}}
          </view>
          <view style="width: 100%;display: flex;align-items: center;justify-content: space-between;">
            <view style="font-size: 30rpx;color: #005832;font-weight: bold;">¥ {{userinfo.user_level == 2 ? item.line_price : (userinfo.user_level == 1 ? item.memberprice : item.normalprice)}}</view>
            <view style="display: flex;align-items: center;">
              <block wx:if="{{item.number>0}}">
                <view class="chanumbox" catch:tap="reducenum" data-type="list" data-index="{{index}}">-</view>
                <input type="num" style="width: 50rpx;text-align: center;font-size: 30rpx;" value="{{item.number}}" bindblur="innum" data-type="list" data-index="{{index}}" catch:tap="none" />
              </block>
              <view class="chanumbox" catch:tap="addnum" data-type="list" data-index="{{index}}">+</view>
            </view>
            <!-- <view style="display: flex;align-items: center;">
              <block wx:if="{{item.number>0}}">
                <view class="chanumbox" catch:tap="reducenum" data-type="list" data-index="{{index}}">-</view>
                <input type="num" style="width: 50rpx;text-align: center;font-size: 30rpx;" value="{{item.number}}" bindblur="innum" data-type="list" data-index="{{index}}" catch:tap="none" />
              </block>
              <view class="chanumbox" catch:tap="addnum" data-type="list" data-index="{{index}}">+</view>
            </view> -->
          </view>
        </view>
      </view>
      <view style="height: 180rpx;"></view>
    </scroll-view>
  </view>
</view>
