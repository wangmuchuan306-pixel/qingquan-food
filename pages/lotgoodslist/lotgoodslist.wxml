<shoppingcart id="shoppingcart" userinfo="{{userinfo}}" tabBarHeight="{{tabBarHeight}}"></shoppingcart>


<van-popup show="{{ show }}" round position="bottom" bind:close="onClose" z-index="998" closeable safe-area-inset-bottom="{{false}}">
  <view style="display: flex;align-items: center;margin: 30rpx;padding-bottom: 30rpx;border-bottom: 2rpx solid #eee;">
    <!-- <view style="display: flex;align-items: center;margin-right: 30rpx;" bind:tap="allcheck">
      <radio color="#003B73" checked="{{allcheck}}" />
      <view style="font-size: 32rpx;color: #003B73;margin-left: 10rpx;">全选</view>
    </view> -->
    <view style="display: flex;align-items: center;" bind:tap="delcartgoods">
      <image src="/images/lajitong.png" style="width: 30rpx;height: 30rpx;" />
      <view style="font-size: 32rpx;color: rgb(102, 92, 92);margin-left: 10rpx;">清空所有</view>
    </view>
  </view>
  <scroll-view style="width: 100%;height: 900rpx;" bindscrolltolower="scrolltolower" scroll-y>
    <view style="width: 690rpx;margin: 30rpx;border-bottom: 2rpx solid #eee;padding-bottom: 30rpx;display: flex;align-items: center;justify-content: space-between;margin-top: 0;" wx:for="{{cartlist}}" wx:key="id" bind:tap="checkcart" data-index="{{index}}">
      <radio checked="{{index == cartindex}}" color="#003B73" />
      <image src="{{item.goods_img}}" style="width: 180rpx;height: 180rpx;border-radius: 20rpx;margin-left: 30rpx;" mode="aspectFill" />
      <view style="margin-left: 30rpx;width: {{boxwidth}}rpx;">
        <view style="width: 100%;font-size: 32rpx;font-weight: bold;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;">{{item.goods_name}}</view>
        <view style="display: flex;align-items: center;margin: 10rpx auto;">
          <view class="hbox" style="height: 120rpx;height: 40rpx;font-size: 24rpx;line-height: 40rpx;">
            <text wx:if="{{item.zttype==12}}">配送/自提</text>
            <text wx:if="{{item.zttype==1}}">仅自提</text>
            <text wx:if="{{item.zttype==2}}">仅配送</text>
          </view>
          <view class="hbox" style="height: 120rpx;height: 40rpx;font-size: 24rpx;line-height: 40rpx;">{{item.xg_num==0?'不限购':'限购 '+item.xg_num}}</view>
        </view>
        <view style="width: 100%;display: flex;align-items: center;justify-content: space-between;">
          <view style="font-size: 36rpx;font-weight: bold;color: #003B73;">￥{{userinfo.level==1?item.memberprice:item.normalprice}}</view>
          <view style="display: flex;align-items: center;">
            <block wx:if="{{item.number>0}}">
              <view class="chanumbox" bind:tap="reducenum" data-type="cart" data-index="{{index}}">-</view>
              <input type="num" style="width: 50rpx;text-align: center;font-size: 30rpx;" value="{{item.number}}" bindblur="innum" data-type="cart" data-index="{{index}}" />
            </block>
            <view class="chanumbox" bind:tap="addnum" data-type="cart" data-index="{{index}}">+</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view style="height: 180rpx;"></view>
</van-popup>
<van-popup show="{{ specshow }}" round position="bottom" bind:close="specsClose" closeable z-index="999">
  <view style="font-size: 30rpx;margin: 30rpx;">已选 {{thisgoods.specs[specsindex].specs_name}}</view>
  <view style="width: 690rpx;margin: 30rpx;border-bottom: 2rpx solid #eee;display: flex;align-items: center;">
    <image src="{{thisgoods.specs[specsindex].specs_img?qiniu+thisgoods.specs[specsindex].specs_img:thisgoods.goods_img}}" style="width: 180rpx;height: 180rpx;border-radius: 20rpx;" mode="aspectFill" />
    <view style="margin-left: 30rpx;width: 480rpx;">
      <view style="width: 100%;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;font-size: 30rpx;">{{thisgoods.goods_name}}</view>
      <view style="color:#999;font-size: 24rpx;margin: 20rpx 0;">
        销量{{thisgoods.volume + 1000}} ·
        <text wx:if="{{thisgoods.all_goodsstock<10}}" style="color: #f30;">{{thisgoods.all_goodsstock==0?'已售罄':'即将售罄'}}</text>
        <text wx:else>库存{{thisgoods.all_goodsstock}}</text>
        <text wx:if="{{thisgoods.xg_num>0}}"> · 限购 {{thisgoods.xg_num}}</text>
      </view>
      <view style="color: #f60;font-size: 30rpx;">￥{{userinfo.user_level == 2 ? thisgoods.specs[specsindex].specs_pfmoney : (userinfo.user_level == 1 ? thisgoods.specs[specsindex].specs_tgmoney : thisgoods.specs[specsindex].specs_erpmoney)}}</view>
    </view>
  </view>
  <view style="font-size: 30rpx;margin: 30rpx;margin-bottom: 0;">选择规格</view>
  <scroll-view style="width: 100%;height: 500rpx;" scroll-y>
    <view class="{{specsindex==index?'isspecs':'specsbox'}}" wx:for="{{thisgoods.specs}}" bind:tap="choosespecs" data-index="{{index}}" style="position: relative;">
      <view wx:if="{{item.shoppingspecs && item.shoppingspecs.number > 0}}" style="position: absolute;top: -10rpx;right: 0rpx;background-color: #f60;color: white;border-radius: 100%;padding: 0 10rpx;height: 32rpx;line-height: 32rpx;text-align: center;font-size: 22rpx;">{{item.shoppingspecs.number}}</view>
      <view style="display: flex;align-items: center;">
        <view style="max-width: 300rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;">{{item.specs_name}}</view>
        <view style="margin-left: 20rpx;color: {{specsindex==index?'':'#999'}};">库存{{item.specs_stock}}</view>
        <!-- <view style="margin-left: 20rpx;color: {{specsindex==index?'':'#999'}};">已售{{item.buy_num}}</view> -->
      </view>
      <!-- <view wx:if="{{is_erp && item.specs_iserp}}" style="margin-left: 20rpx;">¥ {{item.specs_erpmoney}}</view> -->
      <view style="margin-left: 20rpx;">¥ {{userinfo.user_level == 2 ? item.specs_pfmoney : (userinfo.user_level == 1 ? item.specs_tgmoney : (userinfo.user_level == 3 ? item.specs_vipmoney : item.specs_erpmoney))}}</view>
    </view>
  </scroll-view>
  <view style="width: 690rpx;display: flex;align-items: center;justify-content: space-between;margin: 30rpx;">
    <view style="font-size: 30rpx;">数量</view>
    <van-stepper value="{{specsnum}}" bind:change="onChangeshop" min="{{thisgoods.specs[specsindex].shoppingspecs ? 1 : thisgoods.specs[specsindex].specs_batch}}" max="{{specsmaxnum}}" />
  </view>
  <view class="btmbtn" bind:tap="toinshop" style="background-color: {{is_thisspecsadd ? '' : '#ccc'}};">确定</view>
  <view style="height: calc({{tabBarHeight}} - 60rpx);"></view>
</van-popup>