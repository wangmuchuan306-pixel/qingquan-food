      <view style="font-size: 36rpx;color: #003B73;font-weight: bold;">￥{{all_price}}</view>
      <view style="font-size: 24rpx;">金额小计</view>
    </view>
  </view>
  <view class="buybox" bind:tap="tobuy">去结算</view>
