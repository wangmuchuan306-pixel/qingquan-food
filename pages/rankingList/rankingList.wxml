<!--pages/rankingList/rankingList.wxml-->
<page-meta page-style="overflow: hidden;"></page-meta>
<view style="width: 100%;height: 100vh;background-color: #f8f8f8;">
    <scroll refresh="{{refresh}}" bind:onUpdata="hotRanking" loading="{{loading}}" none="{{none}}" refreshType="shuaxin_if" page_loading="{{page_loading}}">
        <view class="body" slot="body">
            <block wx:for="{{hotRankingList}}" wx:key="index">
                <view class="item_box flex2" bindtap="gotoDetail" data-id="{{item.goods_id}}">
                    <view class="item_img_box">
                        <image class="item_img" src="{{item.goods_img}}" />
                        <view wx:if="{{type == 1}}" class="item_img_tip">
                            <view>TOP</view>
                            <view class="item_img_top">{{index + 1}}</view>
                        </view>
                    </view>
                    <view class="item_info">
                        <view class="item_tag_box">
                            <view class="item_name txt2 flex2"><view wx:if="{{item.label_info.length>0}}" class="item_tag" style="background-color:{{item.label_info[0].color}};">{{item.label_info[0].label_name}}</view><text>{{item.goods_name}}</text></view>
                        </view>
                        <view class="item_desc">已售 {{item.volume}} 库存 {{item.all_stock}}</view>
                        <view class="item_price flex3">
                            <view class="item_price_text">¥ {{userinfo.user_level == 2 ? item.line_price : (userinfo.user_level == 1 ? item.memberprice : item.normalprice)}}</view>
                            <!-- <image class="item_price_add" src="{{iconurl}}greenjia_c.png" /> -->
                        </view>
                    </view>
                </view>
            </block>
        </view>
    </scroll>
</view>