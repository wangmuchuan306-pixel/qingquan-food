/* pages/rankingList/rankingList.wxss */
page{
    background-color: #f8f8f8;
}
.scroll_view{
    flex: 1;
    min-height: 0;
}
.body {
    padding: 30rpx;
    width: 100%;
    box-sizing: border-box;
}

.item_box {
    width: 100%;
    padding: 30rpx;
    background-color: #fff;
    border-radius: 20rpx;
    box-sizing: border-box;
    margin-bottom: 30rpx;
}

.item_img_box {
    width: 180rpx;
    height: 180rpx;
    border-radius: 20rpx;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
    margin-right: 20rpx;
}

.item_img {
    width: 100%;
    height: 100%;
}

.item_img_tip {
    padding: 10rpx 14rpx 10rpx 10rpx;
    box-sizing: border-box;
    background-color: #f60;
    position: absolute;
    top: 10rpx;
    left: 10rpx;
    color: #fff;
    font-size: 22rpx;
    font-weight: bold;
    font-style: italic;
    border-radius: 10rpx;
}

.item_img_top {
    font-size: 30rpx;
    text-align: center;
}

.item_info {
    flex: 1;
    min-width: 0;
    height: 180rpx;
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
}

.item_tag_box {
    width: 100%;
    position: relative;
}

.item_tag {
    padding: 0 10rpx;
    height: 36rpx;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10rpx;
    background: #66CC66;
    font-size: 20rpx;
    color: #fff;
    line-height: 36rpx;
    text-align: center;
    white-space: nowrap;
    margin-right: 10rpx;
}

.item_name {
    font-size: 30rpx;
    width: 100%;
}
.item_desc{
    font-size: 24rpx;
    color: #999;
}
.item_price{
    width: 100%;
    font-size: 36rpx;
    color: #f60;
    font-weight: bold;
}
.item_price_text{
    font-size: 36rpx;
    color: #f60;
    font-weight: bold;
}
.item_price_add{
    width: 50rpx;
    height: 50rpx;
}