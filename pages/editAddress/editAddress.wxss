page {
  color: #000;
  background: #eee;
}

/* 没有收货地址 */
.noneAddress {
  margin-top: 230rpx;
  width: 100%;
  font-size: 30rpx;
  text-align: center;
}

.noneAddress image {
  width: 654rpx;
}

/* 收货地址列表 */
.Address {
  padding: 0 30rpx 30rpx 30rpx;
}

.AddressList {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  margin-top: 24rpx;
}

.AddressListName {
  font-size: 26rpx;
  color: #000;
  padding-bottom: 24rpx;
  width: 490rpx;
  margin: 0 24rpx;

}

.addressInfo {
  
  font-size: 34rpx;
  color: #000;
  padding: 24rpx 0 10rpx 0rpx;
  margin: 0 24rpx;
  max-width: 460rpx;
}

.addressFooter {
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  border-top: 2rpx solid #eee;
}

.addressFooter_left {
  font-size: 26rpx;
  color: #999999;
  display: flex;
  align-items: center;
}

.addressFooter_left image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.addressFooter_right {
  display: flex;
  align-items: center;
}

.addressFooter_right image {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.addressFooter_right>view {
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: #A6A5AD;
  margin-left: 50rpx;
}

/* 底部按钮部分 */
.footer {
  width: 100%;
  /* background: #100C1A; */
  position: fixed;
  bottom: 50rpx;
  left: 0rpx;
  padding-bottom: 16rpx;
}

.fix-iphonex-button {
  bottom: 68rpx !important;
}
