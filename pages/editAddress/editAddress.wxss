.footer view {
  text-align: center;
  font-size: 34rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 24rpx 30rpx 0 30rpx;
  border-radius: 100rpx;
}

.weixin {
  background: #09BD15;
  color: #fff;
}

.add {
  background: #000;
  color: #fff;
  /* background: linear-gradient(90deg, #FF9F00, #ff6600); */
}

.listItem {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.useThis {
  margin-right: 30rpx;
  padding: 10rpx 26rpx;
  color: #000;
  font-size: 26rpx;
  border: 1px solid #000;
  border-radius: 30rpx;
}

.listItem .address_check image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 30rpx;
}