/* packageB/pages/mycard/mycard.wxss */ 
.yjboth{
  margin: 0 30rpx;
}
.yjboth_list{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  background: #1C1926;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  position: relative;
}
.yjboth_list_left view:nth-of-type(1){
  font-size:44rpx ;
  color: #FF6600;
  margin-bottom: 10rpx;
}
.yjboth_list_left view:nth-of-type(2){
  font-size:24rpx ;
  color: #929398;
}
.yjboth_list_right{
  width: 56rpx;
  height: 56rpx;
}
/* 待激活 */
.djhkq{
  margin: 0 30rpx;
  padding: 30rpx 30rpx 49rpx 30rpx;
  background: #1C1926;
  border-radius: 16rpx;
}
.djhkq_top{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}
.djhkq_top view:nth-of-type(1){
  font-size: 44rpx; color: #FF6600;
}

.djhkq_list{
  width: 190rpx;height: 200rpx;position: relative;margin-right: 30rpx;
  display: inline-block;
}
.djhkq_list:nth-last-of-type(1){
  margin-right: 0;
}
.djhkq_list image{
  width: 100%;height: 100%;
}
.djhkq_list_je{
  position: absolute;
  top:40rpx;
  font-size: 78rpx;color: #FF6753;
  width: 100%;
  text-align: center;
  font-weight: 600;
}
.djhkq_list_je text{
  position: relative;
}
.djhkq_list_je text::before{
  position: absolute;
  content: '￥';
  font-size: 34rpx;color: #FF6753;
  left: -15rpx;
  bottom: 8rpx;
}
.djhkq_list_num{
  width: 100%;
  position: absolute;
  top: 133rpx;
  text-align: center;
  color: #fff;font-size: 30rpx;
}
/* 已使用 */
.ysykq{
  font-size: 34rpx;color: #fff;
  text-align: center;
  margin-bottom: 30rpx;
}
.yjboth_list_ysy{
  position: absolute;
  width: 162rpx;height: 160rpx;
  top: 0;right: 38rpx;
}






