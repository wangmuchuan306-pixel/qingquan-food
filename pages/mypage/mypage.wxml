<view class="userColumn">
  <view class=" flex2">
    <block>
      <image wx:if="{{userinfo.headimg}}" src="{{userinfo.headimg}}" style="width: 120rpx;height: 120rpx;border-radius: 100%;margin-right: 30rpx;" mode="" />
      <image wx:else src="/images/noimg.png" style="width: 100rpx;height: 100rpx;border-radius: 100%;background-color: white;margin-right: 30rpx;" mode="aspectFill" />
    </block>
    <block>
      <view wx:if="{{userinfo.nickname}}" style="flex: 1;min-width: 0;">
        <view class="flex3" style="width: 100%;">
          <view class="txt1" style="font-weight: bold;font-size: 36rpx;margin-bottom: 10rpx;color: #000;flex: 1;min-width: 0;margin-right: 30rpx;">{{userinfo.nickname}}</view>
          <image src="/images/pen.png" bind:tap="toset" style="width: 30rpx;height: 36rpx;" mode="" />
        </view>
        <view style="font-size: 26rpx;" wx:if="{{userinfo.phone}}">{{userinfo.phone}}</view>
      </view>
      <view wx:else class="flex3" style="flex: 1;min-width: 0;">
        <view style="font-size: 30rpx;font-weight: bold;">您还没有登录呢</view>
        <view class="gbox" bind:tap="gotologin">立即登录</view>
      </view>
    </block>
  </view>
  <!-- <view class="flex2" style="padding-top: 30rpx;">
    <view class="flex2" bindtap="tocard" style="width:50%;border-right: 1rpx solid #eee;">
      <image src="/images/mycard.png" style="width: 68rpx;height: 60rpx;margin-right: 30rpx;" mode="" />
