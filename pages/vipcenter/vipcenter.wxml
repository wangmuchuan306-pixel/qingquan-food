<view style="height: 180rpx;"></view>
<van-popup show="{{ show }}" bind:close="onClose" round>
  <view style="width: 600rpx;height: 400rpx;">
    <view style="font-size: 36rpx;font-weight: bold;text-align: center;margin: 30rpx auto;">兑换年卡</view>
    <view style="width: 540rpx;height: 120rpx;background-color: #eee;margin: 30rpx;border-radius: 20rpx;">
      <input type="text" style="font-size: 30rpx;height: 120rpx;margin-left: 30rpx;" placeholder="请输入16位兑换码" bindinput="incdk" />
    </view>
    <view class="btmbtn" style="width: 540rpx;" bind:tap="getcdkvi">确定</view>
  </view>
</van-popup>
<van-popup show="{{ buysuccess }}" round>
  <view style="width: 560rpx;text-align: center;margin-top: 50rpx;">
    <image src="/images/success.png" style="width: 120rpx;height: 120rpx;" mode=""/>
    <view style="font-size: 38rpx;font-weight: bold;margin-top: 30rpx;">恭喜您</view>
    <view style="font-size: 32rpx;font-weight: bold;margin-top: 30rpx;">已升级为{{open[vipindex].vipname}}会员</view>
    <view class="gbtn" bind:tap="successClose">我知道了</view>
  </view>
</van-popup>