<!--pages/goodsinfo/goodsinfo.wxml-->
<page-meta page-style="{{ buysuccess||commodityshow||showye||balancepayShow ? 'overflow: hidden;' : '' }}" />
<wxs module="filter" src="/utils/numberToFixed.wxs"></wxs>
<view>
  <view style="height: {{height}}px;line-height: {{height}}px;padding-top: {{top}}px;{{commodityshow ? '' : 'position: fixed;'}}" class="topbox" wx:if="{{headShow}}">商品详情</view>
  <view class="leftopbox" style="top: {{top}}px;left: 30rpx;height: {{height}}px;border-radius: {{height/2}}px;" bind:tap="backpage">
    <image src="/images/blackjiantou.png" style="width: 14rpx;height: 24rpx;transform: rotate(180deg);margin-right: 10rpx;" mode="" />
    <view style="font-size: 26rpx;">返回</view>
  </view>
  <!-- <view>
      <image src="{{Detail.goods_img}}" mode="" class="sptp"></image>
    </view> -->
  <view style="position: relative;">
    <swiper autoplay="ture" style="width: 750rpx;height: 800rpx;" bindchange="swiperchenge" current="{{current}}">
      <swiper-item wx:if="{{Detail.goodsvideo}}">
        <video src="{{Detail.goodsvideo}}" style="width: 100%;height: 100%;" autoplay />
      </swiper-item>
      <swiper-item>
        <image src="{{Detail.goods_img}}" style="width: 100%;height: 100%;" mode="aspectFill"></image>
      </swiper-item>
      <swiper-item wx:for="{{Detail.gallery}}">
        <image src="{{item}}" style="width: 100%;height: 100%;" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
    <view class="labelbox" wx:if="{{Detail.label_name}}">{{Detail.label_name}}</view>
    <view style="color: white;position: absolute;bottom: 30rpx;right: 30rpx;">
      <text style="font-size: 42rpx;">{{current+1}}</text>
      <text style="font-size: 24rpx;"> / {{swiperlength}}</text>
    </view>
  </view>
  <view class="xbk">
    <view class="spnc">{{Detail.goods_name}}</view>
    <view class="jg">
      <view class="jc">¥ {{userinfo.user_level == 2 ? Detail.specs_pfmoney_min : (userinfo.user_level == 1 ? Detail.specs_tgmoney_min : (userinfo.user_level == 3 ? Detail.specs_vipmoney_min : Detail.specs_erpmoney_min))}}<text wx:if="{{Detail.specs.length > 1}}"> ~ {{userinfo.user_level == 2 ? Detail.specs_pfmoney_max : (userinfo.user_level == 1 ? Detail.specs_tgmoney_max : (userinfo.user_level == 3 ? Detail.specs_vipmoney_max : Detail.specs_erpmoney_max))}}</text></view>
    </view>
  </view>
  <!-- <view class="xbk">
    <view class="fbt">{{Detail.small_title}}</view>
  </view> -->
  <view style="font-size: 42rpx;font-weight: bold;margin:30rpx">商品详情</view>
  <view style="width: 690rpx;margin: 30rpx;flex-wrap: wrap;white-space: normal;">
    <mp-html content="{{Detail.content}}" />
  </view>
  <import src="/pages/template/template" />
  <template is="bottomtext" data="" />
  <view style="width: 100%;height: 210rpx;opacity: 0;"></view>
  <view class="dbnx" style="position: fixed;bottom: 0;width: 750rpx;padding: 0 30rpx;height: 180rpx;justify-content: space-between;box-sizing: border-box;border-top: 2rpx solid #eee;padding-bottom: 50rpx;">
    <view style="position: relative;" bind:tap="likegoods">
      <image src="/images/{{Detail.iscollect==1?'collection.png':'kongxin.png'}}" mode="" class="gnys"></image>
    </view>
    <view style="position: relative;">
      <image src="/images/kefu1.png" mode="" class="gnys"></image>
      <button open-type="contact" style="width: 100%;height: 100%;position: absolute;top: 0;left: 0;border: none;" plain></button>
    </view>
    <button class="fx" style="font-size: 30rpx;" open-type="share">分享给好友</button>
    <view class="dg" bindtap="{{Detail.specs.length == 1 ? 'commodityshow' : 'showchospecs'}}" style="font-size: 30rpx;">立即订购</view>
  </view>
  <van-popup show="{{commodityshow}}" bind:close="commodityclo" closeable="true" position="bottom" style="z-index: 999;" safe-area-inset-bottom="{{false}}" custom-style="background-color:#eee;">
    <view style="padding: 30rpx 30rpx 0;">
      <view style="font-size: 30rpx;font-weight: bold;">
        订购详情
      </view>
      <view style="width: 690rpx;height: 100rpx;border-radius: 20rpx;background-color: white;display: flex;margin-top: 30rpx;" wx:if="{{Detail.goods_vip_type == 0 || Detail.goods_vip == 2}}">
        <view style="z-index: 1;width: 50%;line-height: 100rpx;text-align: center;font-size: 30rpx;{{chooseStyle==2?'color:white;font-weight: bold;':''}}" bind:tap="chooseStyle" data-id="2" wx:if="{{zttype!=1}}">送货上门</view>
        <view style="z-index: 1;width: 50%;line-height: 100rpx;text-align: center;font-size: 30rpx;color: #999999;" bind:tap="nottap" data-type="2" wx:else>送货上门</view>
        <view style="z-index: 1;width: 50%;line-height: 100rpx;text-align: center;font-size: 30rpx;{{chooseStyle==1?'color:white;font-weight: bold;':''}}" bind:tap="chooseStyle" data-id="1" wx:if="{{zttype!=2}}">线下自提</view>
        <view style="z-index: 1;width: 50%;line-height: 100rpx;text-align: center;font-size: 30rpx;color: #999999;" bind:tap="nottap" data-type="1" wx:else>线下自提</view>
        <view style="width: 334rpx;height: 94rpx;margin: 5rpx;position: absolute;background-color: #003B73;border-radius: 20rpx;z-index: 0;transform: translate({{xdistance}}rpx);transition:transform 0.5s"></view>
      </view>
      <scroll-view scroll-y="true" style="width: 100%;height: 60vh;margin-top: 30rpx;">
      <block wx:if="{{Detail.goods_vip_type == 0 || Detail.goods_vip == 2}}">
         <view style="width: 690rpx;background-color: white;margin: 0 0 30rpx;border-radius: 20rpx;padding-top: 30rpx;" wx:if="{{chooseStyle==2}}">
          <view style="padding-bottom: 30rpx;border-bottom: 2rpx solid #eee;width: 630rpx;margin: 0 auto;" bind:tap="take">
            <view style="width: 630rpx;display: flex;align-items: center;justify-content: space-between;">
              <view style="font-size: 30rpx;">收货地址</view>
              <view style="display: flex;align-items: center;">
                <view wx:if="{{shouAddress}}" style="font-size: 30rpx;color: #003B73;margin-right: 10rpx;">{{shouAddress.username}} {{shouAddress.phone}}</view>
                <image src="/images/blackjiantou.png" mode="" class="yjt"></image>
              </view>
            </view>
            <view style="font-size: 28rpx;color: #999;overflow: hidden;white-space: nowrap;text-overflow: ellipsis;width: 630rpx;margin-top: 30rpx;" wx:if="{{shouAddress}}">{{shouAddress.street}}{{shouAddress.address}}</view>
            <view style="width: 630rpx;margin: 30rpx 0;font-size: 28rpx;color: #999;" wx:else>请选择您的收货地址</view>
          </view>
          <view>
            <view style="width: 630rpx;display: flex;align-items: center;padding: 30rpx;justify-content: space-between;height: 30rpx;">
              <view style="font-size: 30rpx;">送货时间</view>
              <!-- <picker mode="selector" range="{{timelist}}" bindchange="pickerchange" value="{{indexlist}}">
            <view style="display: flex;align-items: center;">
              <view wx:if="{{song_time}}" style="font-size: 28rpx;color: #003300;">{{song_time}}</view>
              <view wx:else style="font-size: 28rpx;color: #999;">请选择送货时间</view>
              <image src="/images/blackjiantou.png" mode="" class="yjt" style="margin-left: 10rpx;"></image>
            </view>
          </picker> -->
              <view class="flex2" bind:tap="changTime">
                <view wx:if="{{zindextime != -1}}" style="font-size: 28rpx;color: #003300;">{{timelist[zindexday].day}}- {{timelist[zindexday].items[zindextime].sendstar}}~{{timelist[zindexday].items[zindextime].sendend}}</view>
                <view wx:else style="font-size: 28rpx;color: #999;">请选择送货时间</view>
                <image src="/images/blackjiantou.png" mode="" class="yjt" style="margin-left: 10rpx;"></image>
              </view>
            </view>
          </view>
          <view style="font-size: 26rpx;color: #f60;padding: 0 30rpx 30rpx;width: 100%;box-sizing: border-box;">{{send_tip}}</view>
        </view>
        <view style="width: 690rpx;background-color: white;margin: 0 0 30rpx;border-radius: 20rpx;padding-top: 30rpx;" wx:else>
          <!-- <picker mode="selector" range="{{ztdianlist}}" range-key="zt_name" bindchange="changeziti"> -->
          <view style="padding-bottom: 30rpx;border-bottom: 2rpx solid #eee;width: 630rpx;margin: 0 auto;" bind:tap="choztdian">
            <view style="width: 630rpx;display: flex;align-items: center;justify-content: space-between;">
              <view style="font-size: 30rpx;">自提门店</view>
              <view style="display: flex;align-items: center;">
                <view wx:if="{{ztdian}}" style="font-size: 30rpx;color: #003B73;margin-right: 10rpx;">{{ztdian.zt_name}}</view>
                <view wx:else style="font-size: 30rpx;color: #003B73;margin-right: 10rpx;">请选择自提门店地址</view>
                <image src="/images/blackjiantou.png" mode="" class="yjt"></image>
              </view>
            </view>
            <view style="font-size: 28rpx;color: #999;overflow: hidden;white-space: nowrap;text-overflow: ellipsis;width: 630rpx;margin-top: 30rpx;" wx:if="{{ztdian}}">{{ztdian.zt_addressxinagxi}}</view>
            <view style="width: 630rpx;margin-top: 30rpx;font-size: 28rpx;color: #999;" wx:else>您还没有选择自提地址</view>
          </view>
          <!-- </picker> -->
          <view style="width: 630rpx;display: flex;align-items: center;padding: 30rpx;justify-content: space-between;height: 30rpx;">
            <view style="font-size: 30rpx;">提货电话</view>
            <input type="number" placeholder="请填写提货人手机号码" placeholder-style="font-size: 28rpx;color: #999;" value="{{userphone}}" bindinput="inuphone" style="font-size: 28rpx;color: #003300;text-align: right;" maxlength="11" />
          </view>
          <view style="font-size: 26rpx;color: #f60;padding: 0 30rpx 30rpx;width: 100%;box-sizing: border-box;">{{send_tip}}</view>
        </view>
      </block>
        <view style="width: 690rpx;background-color: white;margin: 30rpx 0;border-radius: 20rpx;padding-top: 30rpx;">
          <view style="display: flex;width: 630rpx;margin: 0 auto;">
            <image src="{{Detail.goods_img}}" mode="aspectFill" class="tx"></image>
            <view>
              <view style="overflow: hidden;text-overflow: ellipsis;white-space: nowrap;width: 440rpx;">{{Detail.goods_name}}</view>
              <view class="fbt" style="overflow: hidden;text-overflow: ellipsis;white-space: nowrap;width: 440rpx;">
                {{Detail.small_title}}
              </view>
              <view style="display: flex;align-items: center;justify-content: space-between;width: 440rpx;">
                <view class="money">￥ {{userinfo.level==1?Detail.memberprice:Detail.normalprice}}</view>
                <van-stepper value="{{num}}" bind:change="onChange"></van-stepper>
              </view>
            </view>
          </view>
          <view style="width: 630rpx;display: flex;align-items: center;justify-content: space-between;margin: 30rpx;border-bottom: 2rpx solid #eee;padding-bottom: 30rpx;">
            <view style="font-size: 30rpx;">商品小计</view>
            <view style="display: flex;align-items: center;">
              <text style="font-size:28rpx;color:#030;margin-right: 10rpx;">￥{{zongmoney}}</text>
            </view>
          </view>
          <view style="width: 630rpx;display: flex;align-items: center;justify-content: space-between;margin: 30rpx;border-bottom: 2rpx solid #eee;padding-bottom: 30rpx;">
            <view style="font-size: 30rpx;color: red;">使用卡券</view>
            <view style="display: flex;align-items: center;" bind:tap="choosecard">
              <text style="font-size:28rpx;color:red;margin-right: 10rpx;" wx:if="{{coupons&&coupons.length>0}}">-￥{{coupon_money}} x {{coupons.length}}</text>
              <text style="font-size:28rpx;color:{{have_quan >0 ? 'red':'red'}};margin-right: 10rpx;" wx:else>{{have_quan >0?'您有'+have_quan+'张可用优惠券':'没有可使用的优惠券'}}</text>
              <image src="/images/blackjiantou.png" mode="" class="yjt"></image>
            </view>
          </view>
          <view class="underline flex3">
            <view class="flex2">
              <text class="orderH2" style="color:red;">使用积分</text>
              <!-- <van-switch checked="{{checked}}" bind:change="checkedChan" active-color="#003B73" inactive-color="#f8f8f8" size="20px" style="margin-left: 20rpx;margin-bottom: -10rpx;" /> -->
            </view>
            <view class="flex2" bind:tap="balanShow">
              <text style="font-size: 28rpx;color: red;margin-right: 20rpx;">{{'-'+reduce_balance}} (￥{{all_balance}})</text>
              <image src="/images/blackjiantou.png" style="width: 14rpx;height: 24rpx;" mode="" />
            </view>
          </view>
          <view style="width: 630rpx;margin: 30rpx;padding-bottom: 30rpx;border-bottom: 2rpx solid #eee;display: flex;align-items: center;justify-content: space-between;">
            <view style="font-size: 30rpx;">配送费</view>
            <view style="font-size: 28rpx;">￥{{express}}</view>
          </view>
          <view style="width: 630rpx;margin: 30rpx;padding-bottom: 30rpx;display: flex;align-items: center;justify-content: space-between;">
            <view style="font-size: 30rpx;">总计</view>
            <view style="font-size: 28rpx;">￥{{zongprice}} <text style="color: red;"> (已减 ¥{{all_money}})</text></view>
          </view>
        </view>
        <view style="padding: 30rpx;background-color: #fff;border-radius: 20rpx;">
          <view class="flex3">
            <view class="flex2">
              <view style="font-size: 30rpx;color: #000;">订单备注</view>
            </view>
            <view style="color: #ccc;">{{notexNum}}/30</view>
          </view>
          <textarea bindinput="notesValue" value="{{notesValue}}" style="padding: 30rpx 0 0;width: 100%;height: 50rpx;font-size: 28rpx;" type="text" maxlength="30" placeholder="输入留言" disable-default-padding="true" placeholder-style="color:#ccc;font-size: 28rpx;" />
        </view>
        <view style="height: 100rpx;"></view>
      </scroll-view>
    </view>
    <!-- <view class="xian"></view>
      <view style="width: 690rpx;display: flex;align-items: center;justify-content: space-between;">
        <view style="font-size: 30rpx;">使用余额</view>
        <view style="display: flex;align-items: center;" bind:tap="chooseye">
          <text style="font-size:24rpx;color:#f60;" wx:if="{{useye &&money != 0}}">-￥{{reducemoney}}</text>
          <text style="font-size:24rpx;color:#65696D;" wx:else>{{userinfo.blance==0.00?'暂无可用余额':'账户余额'+userinfo.blance}}</text>
          <image src="/images/blackjiantou.png" style="margin-left: 10rpx;" mode="" class="yjt"></image>
        </view>
      </view> -->
    <!-- <view class="xian"></view> -->
    <!-- <view style="width: 690rpx;display: flex;align-items: center;justify-content: space-between;">
        <view style="font-size: 30rpx;">送货时间</view>
        <picker mode="multiSelector" range="{{picklist}}" bindcolumnchange="columnchange" bindchange="pickerchange" value="{{indexlist}}">
          <view style="display: flex;align-items: center;">
            <view wx:if="{{song_time}}" style="font-size: 24rpx;">{{song_time}}时</view>
            <view wx:else style="font-size: 24rpx;color: #999;">请选择送货时间</view>
            <image src="/images/blackjiantou.png" mode="" class="yjt" style="margin-left: 10rpx;"></image>
          </view>
        </picker>
      </view> -->
    <!-- <view class="xian"></view> -->
    <!-- <view>
        <view class="shdz" bindtap="take" style="display: flex;justify-content: space-between;align-items: center;">
          <view wx:if="{{shouAddress}}" style="width: 80%;">
            <view class="add">{{shouAddress.street}}</view>
            <view class="add_fon">{{shouAddress.username}} {{shouAddress.phone}}</view>
          </view>
          <view wx:else>
            <view class="add">收货地址</view>
            <view class="add_fon">您还没选择收货地址</view>
          </view>
          <image src="/images/blackjiantou.png" mode="" class="yjt"></image>
        </view>
      </view> -->
    <view style="height: 180rpx;width: 100%;padding: 20rpx 30rpx 0;box-sizing: border-box;background-color: #fff;">
      <view class="flex3">
        <view>
          <view style="font-size: 36rpx;color: #003B73;font-weight: bold;">￥{{zongprice}}</view>
          <view style="font-size: 24rpx;color: #999;">实付金额</view>
        </view>
        <view class="tjdd1 flex1" bindtap="back">
          提交订单
        </view>
      </view>
    </view>
  </van-popup>
  <!-- 余额选择 -->
  <van-popup show="{{ showye }}" round position="bottom" custom-style="height: 43vh" bind:close="Closeye">
    <view class="withdrawal_title">
      <view class="withdrawal_title_title">
        <view>余额支付</view>
        <view wx:if="{{smallten == 0}}">{{!money?'请输入使用金额，须为≥1元的整数':'您将使用余额'+money+'用于本单支付'}}</view>
        <!-- <view wx:elif="{{smallten==1&&money!=''}}" style="color:red;font-weight:600;"> 输入金额不可超出订单总额
					¥{{zongprice}} </view>
				<view wx:elif="{{smallten==2&&money!=''}}" style="color:red;font-weight:600;">输入金额不可超出最大可用金额
					¥{{zongprice}} </view> -->
      </view>
      <image bindtap="onClose" src="{{url}}/summer/close02.png?{{veision}}"></image>
    </view>
    <view class="import">
      <!-- <view class="qian">￥</view> -->
      <input value="{{money}}" type="number" bindblur="onblur1" placeholder="本单最多可用{{canpayblance}}" placeholder-class="input_place" bindinput="getmoney" cursor-spacing="160" adjust-position="true"></input>
      <view class="allmoney" bindtap="allDrawal">全部使用</view>
    </view>
    <view class="import_bottom">
      <view>账户余额 ￥{{mymoney?mymoney:0.00}}，订单金额 ￥{{zongprice}}</view>

    </view>
    <button class="tixian" disabled="{{disabled}}" bindtap="walletDrawal">确认使用</button>
  </van-popup>
</view>
<van-popup show="{{ buysuccess }}" round>
  <view style="width: 560rpx;text-align: center;margin-top: 50rpx;">
    <image src="/images/success.png" style="width: 120rpx;height: 120rpx;" mode="" />
    <view style="font-size: 38rpx;font-weight: bold;margin-top: 30rpx;">恭喜您</view>
    <view style="font-size: 32rpx;font-weight: bold;margin-top: 30rpx;">已升级为{{Detail.vipname}}会员</view>
    <view class="gbtn" bind:tap="successClose">我知道了</view>
  </view>
</van-popup>
<van-popup show="{{balancepayShow}}" custom-style="z-index: 999;" round position="bottom" bind:click-overlay="closePopup2">
  <view style="width: 690rpx;padding: 30rpx;">
    <view class="flex3" style="margin-bottom: 50rpx;">
      <view class="flex2">
        <text style="font-size: 40rpx;font-weight: bold;color: #333;">积分支付</text>
      </view>
      <image src="/images/del2.png" bind:tap="closePopup2" style="width: 30rpx;height: 30rpx;" mode="" />
    </view>
    <view class="flex3" style="padding-bottom: 30rpx;border-bottom: 1rpx solid #eee;">
      <view class="flex2">
        <text style="font-size: 46rpx;font-weight: bold;color: #333;margin-right: 30rpx;">￥</text>
        <input type="number" value="{{balanMoney2}}" bindinput="balanValue" confirm-type="done" style="height: 70rpx;width: 400rpx;" />
      </view>
      <view class="flex1" bind:tap="balanValue2" style="font-size: 26rpx;border-radius: 40rpx;width: 160rpx;height: 70rpx;border: 1rpx solid #003B73;color: #003B73;"><text>最多可用</text></view>
    </view>
    <view style="font-size: 24rpx;margin: 30rpx 0rpx;">账户积分 ￥{{integral}} , 订单金额 ￥{{all_zongprice}}</view>
    <view style="width: 630rpx;padding: 30rpx;background-color: #f8f8f8;border-radius: 20rpx;font-size: 24rpx;color: #999;">
      <view>1. 退款后抵扣金额自动退回到余额</view>
      <view>2. 积分与人民币的比例为 100 ： 1</view>
    </view>
    <view class="flex1" bind:tap="validated" style="font-size: 30rpx;color: #fff;width: 690rpx;height: 100rpx;border-radius: 20rpx;background-color: #003B73;margin: 60rpx 0rpx 0rpx;"><text>确认使用</text></view>
  </view>
</van-popup>
<van-popup show="{{timeShow}}" custom-style="z-index: 999;" round position="bottom" bind:click-overlay="closePopup">
  <view style="width: 100%;padding: 30rpx;box-sizing: border-box;">
    <view class="flex3">
      <text style="font-size: 32rpx;color: #000;font-weight: bold;">选择送货时间</text>
      <image src="/images/del2.png" bind:tap="closePopup" style="width: 30rpx;height: 30rpx;" mode="" />
    </view>
    <!-- <view class="flex2" wx:if="{{noticeText}}" style="width: 100%;margin-top: 10rpx;">
      <text style="font-size: 26rpx;">友情提示：</text>
      <van-notice-bar text="{{noticeText}}" color="#f60" background="#fff" custom-class="time" style="width: 80%;" />
    </view> -->
  </view>
  <view class="flex2" style="height: 50vh;">
    <scroll-view style="width: 250rpx;height: 100%;background-color: #f6f6f6;padding: 16rpx 20rpx;box-sizing: border-box;">
      <block wx:for="{{timelist}}">
        <view class="flex1 {{indexday == index ? 'day_act' : ''}}" bind:tap="selectDay" data-index="{{index}}" style="width: 210rpx;height: 60rpx;font-size: 24rpx;{{index + 1  == timelist.length ? '' : 'margin-bottom: 20rpx;'}}"><text>{{item.day}}</text></view>
      </block>
    </scroll-view>
    <scroll-view style="width: 500rpx;height: 100%;background-color: #fff;padding: 16rpx 30rpx 16rpx 50rpx;box-sizing: border-box;">
      <block wx:for="{{timelist[indexday].items}}">
        <view class="flex3 {{indextime == index ? 'time_act' : ''}}" bind:tap="selectTime" data-index="{{index}}" style="font-size: 30rpx;height: 60rpx;width: 100%;{{index + 1  == timelist[indexday].items.length ? '' : 'margin-bottom: 30rpx;padding-bottom: 30rpx;border-bottom: 1rpx solid #eee;'}}">
          <text>{{item.sendstar + '-' + item.sendend}}</text>
          <image wx:if="{{indextime == index}}" src="/images/timeset.png" style="width: 40rpx;height: 40rpx;" mode="" />
        </view>
      </block>
    </scroll-view>
  </view>
  <view class="flex2" style="height: 50rpx;">
    <view style="width: 250rpx;height: 100%;background-color: #f6f6f6;"></view>
    <view style="width: 500rpx;height: 100%;background-color: #fff;"></view>
  </view>
</van-popup>
<van-popup show="{{zitiquerenshow}}" round z-index="1000" bind:click-overlay="guanbi">
  <view class="ztbody flex1" style="{{ztdian ? 'height:720rpx;':''}}">
    <view class="flex1">
      <view class="xian2"></view>
      <view class="ztH1">{{ztdian ? '确认' : '选择'}}自提点</view>
      <view class="xian2"></view>
    </view>
    <view style="font-size: 36rpx;color: #000;font-weight: bold;margin: 30rpx 0 20rpx;">{{ztdian ? '请确认是否在此自提点' : '已为您推荐距离最近自提点'}}</view>
    <view wx:if="{{ztdian}}" style="font-size: 36rpx;color: #000;font-weight: bold;margin: 0 0 40rpx;">提货</view>
    <image style="width: 120rpx;height: 120rpx;border-radius: 60rpx;background-color: #993300;flex-shrink: 0;" src="{{ztdian2.zt_headimg}}"></image>
    <view class="flex2" style="font-size: 24rpx;color: #666;margin: 20rpx 0 30rpx;"><view style="max-width: 300rpx;" class="txt1">{{ztdian2.zt_name}}</view> | 距您{{ztdian2.distance}}km</view>
    <view class="ztbut1 flex1" bind:tap="choztdian123"><text>选择其他自提点</text></view>
    <view class="ztbut2 flex1" bind:tap="yesztdian"><text>确认并提交订单</text></view>
  </view>
</van-popup>

<van-popup show="{{ specshow }}" round position="bottom" bind:close="specsClose" closeable z-index="999">
  <view style="font-size: 30rpx;margin: 30rpx;">已选 {{Detail.specs[specsindex].specs_name}}</view>
  <view style="width: 690rpx;margin: 30rpx;border-bottom: 2rpx solid #eee;display: flex;align-items: center;">
    <image src="{{Detail.specs[specsindex].specs_img?qiniu+Detail.specs[specsindex].specs_img:Detail.goods_img}}" style="width: 180rpx;height: 180rpx;border-radius: 20rpx;" mode="aspectFill" />
    <view style="margin-left: 30rpx;width: 480rpx;">
      <view style="width: 100%;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;font-size: 30rpx;">{{Detail.goods_name}}</view>
      <view style="color:#999;font-size: 24rpx;margin: 20rpx 0;">
        销量{{Detail.volume + 1000}} ·
        <text wx:if="{{Detail.all_goodsstock<10}}" style="color: #f30;">{{Detail.all_goodsstock==0?'已售罄':'即将售罄'}}</text>
        <text wx:else>库存{{Detail.all_goodsstock}}</text>
        <text wx:if="{{thisgoods.xg_num>0}}"> · 限购 {{thisgoods.xg_num}}</text>
      </view>
      <view style="color: #f60;font-size: 30rpx;">￥{{userinfo.user_level == 2 ? Detail.specs[specsindex].specs_pfmoney : (userinfo.user_level == 1 ? Detail.specs[specsindex].specs_tgmoney : (userinfo.user_level == 3 ? Detail.specs[specsindex].specs_vipmoney : Detail.specs[specsindex].specs_erpmoney))}}</view>
    </view>
  </view>
  <view style="font-size: 30rpx;margin: 30rpx;margin-bottom: 0;">选择规格</view>
  <scroll-view style="width: 100%;height: 500rpx;" scroll-y>
    <view class="{{specsindex==index?'isspecs':'specsbox'}}" wx:for="{{Detail.specs}}" bind:tap="choosespecs" data-index="{{index}}">
      <view style="display: flex;align-items: center;">
        <view style="max-width: 300rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;">{{item.specs_name}}</view>
        <view style="margin-left: 20rpx;color: {{specsindex==index?'':'#999'}};">库存{{item.specs_stock}}</view>
        <!-- <view style="margin-left: 20rpx;color: {{specsindex==index?'':'#999'}};">已售{{item.buy_num}}</view> -->
      </view>
      <!-- <view wx:if="{{is_erp && item.specs_iserp}}" style="margin-left: 20rpx;">¥ {{item.specs_erpmoney}}</view> -->
      <view style="margin-left: 20rpx;">¥ {{userinfo.user_level == 2 ? item.specs_pfmoney : (userinfo.user_level == 1 ? item.specs_tgmoney : (userinfo.user_level == 3 ? item.specs_vipmoney : item.specs_erpmoney))}}</view>
    </view>
  </scroll-view>
  <view style="width: 690rpx;display: flex;align-items: center;justify-content: space-between;margin: 30rpx;">
    <view style="font-size: 30rpx;">数量</view>
    <van-stepper value="{{specsnum}}" bind:change="onChangeshop" min="{{Detail.specs[specsindex].specs_batch}}" max="{{specsmaxnum}}" />
  </view>
  <view class="btmbtn" bind:tap="{{is_thisspecsadd ? 'commodityshow' : ''}}" style="background-color: {{is_thisspecsadd ? '' : '#ccc'}};">确定</view>
</van-popup>