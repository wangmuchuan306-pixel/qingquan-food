/**index.wxss**/
page {
  padding-bottom: 30rpx;
  background-color: #f8f8f8;
}
.naviBar {
  width: 100%;
  height: 100%;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.body {
  width: 100%;
  height: auto;
  padding: 10rpx 30rpx;
  box-sizing: border-box;
}

@keyframes marquee {
  0% {
    transform: translateX(30%) translateY(-50%);
  }

  100% {
    transform: translateX(calc(-100% - 36rpx - 10rpx)) translateY(-50%);
  }
}


.asdf_box {
    width: 100%;
    padding: 10rpx 30rpx 20rpx;
    box-sizing: border-box;
    /* background-color: #fff; */
}

.search_box {
    --bg-color: #fff;
    --h: 70rpx;
    position: relative;
    flex: 1;
    min-width: 0;
    height: var(--h);
    background-color: var(--bg-color);
    border-radius: calc(var(--h) / 2);
    padding: 0 20rpx;
    box-sizing: border-box;
}

.search_box::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

.search_input {
    flex: 1;
    min-width: 0;
    height: 70rpx;
    margin-left: 10rpx;
    box-sizing: border-box;
    font-size: 26rpx;
    color: #999;
    line-height: 70rpx;
}

.item_desc{
    font-size: 22rpx;
    color: #666;
    margin-bottom: 10rpx;
}

.cateScroll {
    width: 710rpx;
    margin: 0 auto;
    padding: 20rpx;
    box-sizing: border-box;
    border-radius: 20rpx;
    height: 190rpx;
    position: sticky;
    top: 0;
    z-index: 999;
    background-color: #fff;
}

.cate_top {
    animation: cate_top 0.5s ease-in-out forwards;
}

@keyframes cate_top {
    0% {
        margin-right: 30rpx;
    }

    100% {
        margin-right: 60rpx;
        margin-left: 10rpx;
    }
}

.cateScroll_top {
    animation: cateScroll_top 0.5s ease-in-out forwards;
}

@keyframes cateScroll_top {
    0% {
        height: 150rpx;
    }

    100% {
        height: 170rpx;
    }
}

.cate_text_top {
    animation: cate_text_top 0.5s ease-in-out forwards;
}

@keyframes cate_text_top {
    0% {
        font-size: 24rpx;
        margin-top: 0;
    }

    100% {
        font-size: 30rpx;
        margin-top: 50rpx;
    }
}

.catebox {
    height: 150rpx;
}

.cateitem {
    width: 100rpx;
    /* height: 150rpx; */
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 30rpx;
}
.cateitem:last-child {
  margin-right: 0;
}

.cateitem image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 10rpx;
}

.cateitem view {
  font-size: 24rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.cate_act {
  color: var(--theme-color);
  font-weight: bold;
  border-bottom: 6rpx solid var(--theme-color);
  padding-bottom: 4rpx;
}

.homeTop {
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.flpt_box {
  width: calc(50% - 10rpx);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.zb_box {
  position: relative;
  width: 100%;
}

.zb_img {
  width: 100%;
  height: 305rpx;
  background-color: #f8f8f8;
  border-radius: 20rpx;
}

.zbstatus {
  width: 140rpx;
  height: 40rpx;
  border-radius: 20rpx;
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background-color: rgba(0, 0, 0, .5);
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.livebox {
  width: 54rpx;
  height: 30rpx;
  background-color: #f60;
  border-radius: 15rpx;
  text-align: center;
  line-height: 30rpx;
  color: white;
  font-size: 20rpx;
}

.live_box {
  width: calc(50% - 10rpx);
  margin-right: 20rpx;
  height: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.live_title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.live_all {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.live_jian {
  width: 14rpx;
  height: 24rpx;
}

.oneorder_img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 10rpx;
}

.oneorder_price {
  font-size: 20rpx;
  color: #f60;
  margin-top: -4rpx;
}

.order_box {
  flex: 1;
  min-height: 0;
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.order_box:last-child {
  margin-bottom: 0;
}

.index_swiper {
  width: 100%;
  height: 100%;
}

.fl_box {
  width: 100%;
  flex: 1;
  min-height: 0;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.fl_box:last-child {
  margin-bottom: 0;
}

.fl_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}



.gblw_img {
  width: 325rpx;
  height: 325rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.gblw_box {
  --w: 20rpx;
  width: calc(100% - var(--w) * 2);
  margin: 20rpx auto 0;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 20rpx;
  height: 640rpx;
  display: flex;
  flex-direction: column;
}

.jianbianbj{
  width: 100%;
  height: 500rpx;
  background: linear-gradient(180deg, #003B73 0%, transparent 100%);
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}