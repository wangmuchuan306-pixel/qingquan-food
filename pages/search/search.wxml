          <image wx:if="{{hotA.ishot}}" src="https://yhtapi.ehetuan.cn/summer/remen.png" style="width: 40rpx;height: 40rpx;" mode=""/>
          <text style="font-size: 30rpx;margin-left: 10rpx;">{{hotA.search_name}}</text>
        </view>
      </view>
    </view>
  </view> -->
</view>
<!-- 搜索后显示商品列表 -->
<view hidden="{{!pageShow}}" style="width: 690rpx;padding: 30rpx;">
  <block wx:for="{{goodsList}}" wx:key="car">
    <view class="flex2 goodsFor" bind:tap="gotodetails" data-id="{{item.goods_id}}">
      <image class="goodsImage" src="{{item.goods_img}}" mode="aspectFill" />
      <view class="goodsDetails">
        <view class="goodsH1">{{item.goods_name}}</view>
        <view class="goodsH2">库存 {{item.all_goodsstock}} / 销量 {{item.volume + 1000}}</view>
        <view class="flex2 goodsLabel">
          <view class="goodsLabel1 txt1">{{item.zttype == 1 ? '仅自提' : item.zttype == 2 ? '仅配送' : '配送/自提'}}</view>
          <view class="goodsLabel1 txt1">{{item.xg_num==0 ? '不限购' : '限购 '+ item.xg_num}}</view>
        </view>
        <view class="goodsH3 flex3">
          <text>￥ {{userinfo.user_level == 2 ? item.specs_pfmoney : (userinfo.user_level == 1 ? item.specs_tgmoney : (userinfo.user_level == 3 ? item.specs_vipmoney : item.specs_erpmoney))}}<text wx:if="{{item.specs.length > 1}}" style="color: #999;font-size: 22rpx;"> 起</text></text>
          <!-- 加号/减号 -->
          <!-- <view class="SurvivalOrDeath flex2">
              <image wx:if="" src="/images/minusSign.png" mode=""/>
              <input wx:if="" type="text"/>
              <image src="/images/plusSign.png" mode=""/>
            </view> -->
        </view>
      </view>
    </view>
  </block>
</view>
<import src="/pages/template/template" />
<template is="publicFooter" data="{{pageSet}}"></template>