<!--packageA/pages/exchangeCDK/exchangeCDK.wxml-->
<view class="duihuan">
  <!-- <view class="shuru">请输入18位验证码</view> -->
  <input class="shuru" type="text" placeholder="请输入或粘贴16位兑换码" placeholder-style="color:#ccc" bindinput="getValues" />
  <view class="shuru1" bindtap="goResult" wx:if="{{cdk.length>15}}">立即兑换</view>
  <view class="shuru2" wx:else>立即兑换</view>
</view>

<view class="bot">
  <view style="font-weight:800">· 兑换码组成</view>
  <view class="bot1">正确兑换码由16位数字和字母组合而成。</view>
  <view style="font-weight:800">· 兑换码获取</view>
  <!-- 参与{{procedure.wxname}} -->
  <view class="bot1">请您刮开清泉食品实体年卡图层即可获得兑换码。</view>
  <view style="font-weight:800">· 兑换码使用</view>
  <view class="bot1">在当前页面输入兑换码即可兑换相应优惠券或充值卡。一个兑换码只能兑换一次，不可重复使用。</view>
  <view style="font-weight:800">· 提示</view>
  <view class="bot1">兑换码可复制粘贴，输入时请使用英文输入法区分大小写。</view>
</view>

<view>

</view>