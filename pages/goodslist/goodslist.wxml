<!--pages/goodslist/goodslist.wxml-->
<view style="width: 100%;background-color: white;height: 100rpx;display: flex;align-items: center;justify-content: space-between;">
  <view style="width: 580rpx;height: 70rpx;background-color: #eee;border-radius: 30rpx;margin-left: 30rpx;display: flex;align-items: center;justify-content: space-between;">
    <view style="display: flex;align-items: center;margin-left: 20rpx;">
      <icon type="search" color="#999" size="18" />
      <input type="text" placeholder-style="font-size:30rpx;color:#999" placeholder="输入感兴趣的商品" bindinput="insearchstr" style="font-size: 30rpx;margin-left: 10rpx;" bindconfirm="tosearch" confirm-type="search" value="{{searchstr}}" />
    </view>
    <image wx:if="{{searchstr}}" bind:tap="nosearchstr" src="https://yhtapi.ehetuan.cn/yht/fill.png" style="width: 30rpx;margin-right: 20rpx;height: 30rpx;" />
  </view>
  <view style="font-size: 30rpx;color: {{searchstr?'':'#999'}};margin-right: 30rpx;" bind:tap="tosearch">搜索</view>
</view>
<block wx:if="{{showtype==1}}">
  <view style="display: flex;width: 100%;">
    <scroll-view style="width: 200rpx;height: {{windowHeight-(100*pixelRatio)}}px;background-color: #eee;" scroll-y>
      <view class="leftbox">
        <view wx:for="{{catelist}}" class="{{cateindex==index?'thiscate':'catebox'}}" bind:tap="changecate" data-index="{{index}}">{{item.cate_name}}</view>
      </view>
    </scroll-view>
    <scroll-view style="width: 550rpx;height: {{windowHeight-(100*pixelRatio)}}px;" scroll-y bindscrolltolower="scrolltolower">
      <view wx:if="{{goodslist.length == 0}}" style="text-align: center;font-size: 30rpx;color: #999;margin-top: 200rpx;">暂无商品</view>
      <block wx:else>
        <view class="goodsbox" wx:for="{{goodslist}}" bind:tap="choosegoods" data-index="{{index}}">
          <image src="{{item.goods_img}}" style="width: 140rpx;height: 140rpx;border-radius: 20rpx;margin-right: 30rpx;" mode="aspectFill" />
          <view>
            <view style="font-size: 28rpx;width: 350rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;">{{item.goods_name}}</view>
            <view style="font-size: 22rpx;color: #999;margin: 10rpx 0;">市场价 ￥{{item.line_price}} 已售 {{item.volume}} </view>
            <view style="font-size: 30rpx;color: #003B73;">￥{{userinfo && userinfo.level==1?item.memberprice:item.normalprice}}</view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</block>
<block wx:else>
  <scroll-view style="width: 100%;height: {{windowHeight-(100*pixelRatio)}}rpx;" scroll-y bindscrolltolower="scrolltolower">
    <view wx:if="{{goodslist.length == 0}}" style="text-align: center;font-size: 30rpx;color: #999;margin-top: 200rpx;">暂无商品</view>
    <block wx:else>
      <view wx:for="{{goodslist}}" style="width: 690rpx;height: 120rpx;display: flex;align-items: center;justify-content: space-between;margin: 0 30rpx;border-bottom: 2rpx solid #eee;" bind:tap="choosegoods" data-index="{{index}}">
        <view style="font-size: 26rpx;font-weight: bold;">{{item.goods_name}}</view>
        <view style="font-size: 26rpx;color: #003B73;">￥{{userinfo.level==1?item.memberprice:item.normalprice}}</view>
      </view>
    </block>
  </scroll-view>
</block>