@charset "UTF-8";
/* component/goodscard/goodscard.wxss */
.goods_box[data-theme='light'] {
  background-color: #fff;
}

.goods_box[data-theme='dark'] {
  background-color: #1C1926;
}

.retail_list_right_title[data-theme='light'] {
  color: #000;
}

.retail_list_right_title[data-theme='dark'] {
  color: #fff;
}

.retail_list[data-theme='light'] {
  border-bottom: 2rpx solid #eee;
}

.retail_list[data-theme='dark'] {
  border-bottom: 2rpx solid #1A1D28;
}

.retail_list_right_center[data-theme='light'] {
  color: #999;
}

.retail_list_right_center[data-theme='dark'] {
  color: #FEE1C3;
}

.r_price[data-theme='light'] {
  color: #f60;
}

.r_price[data-theme='dark'] {
  color: #F1B493;
}

.retail_list {
  width: 100%;
  margin: 20rpx 0;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #242535;
  height: auto;
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 30rpx;
}

.sheng {
  position: absolute;
  font-size: 24rpx;
  color: #fff;
  border-radius: 100rpx;
  background: #f60;
  padding: 0 8rpx;
  line-height: 36rpx;
  bottom: 10rpx;
  right: 10rpx;
  z-index: 9;
}

.r_jiaobiao {
  position: absolute;
  width: 122rpx;
  height: 122rpx;
  top: -11rpx;
  left: -11rpx;
  overflow: hidden;
}

.r_jiaobiao image {
  width: 100%;
  height: 100%;
}

.r_jiaobiao1 {
  transform: rotate(-45deg);
  /* position: absolute;
  top: 20rpx;
  left: 12rpx; */
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  line-height: 84rpx;
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 60rpx;
  word-break: keep-all;
}

.retail_cover {
  width: 240rpx;
  height: 240rpx;
  border-radius: 16rpx;
  margin-right: 36rpx;
  overflow: hidden;
  position: relative;
}

.retail_cover image {
  width: 100%;
  height: 100%;
}

.retail_list_right {
  width: 59%;
  margin-top: -7rpx;
}

.retail_list_right_title {
  width: 100%;
  font-size: 30rpx;
  /* font-weight: bold; */
  text-overflow: -o-ellipsis-lastline;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
  color: #fff;
}

.goods_label {
  font-size: 24rpx;
  color: #eeeeee;
  padding: 0 8rpx;
  line-height: 34rpx;
  background: #f60;
  border-radius: 4rpx;
  margin-right: 10rpx;
  font-weight: 600;
}

.r_price {
  font-size: 38rpx;
  line-height: 52rpx;
  color: #F1B493;
  position: relative;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}

.r_price::before {
  content: '￥';
  font-size: 24rpx;
  position: absolute;
  left: -20rpx;
  bottom: -2rpx;
}

.unPrice {
  font-size: 24rpx;
  color: #999999;
  position: relative;
}

.r_num {
  font-size: 24rpx;
  color: #ff6600;
}

.retail_list_right_center {
  font-size: 24rpx;
  color: #FEE1C3;
  line-height: 34rpx;
  padding-bottom: 16rpx;
}

.retail_list_right_footer {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.retail_list_right_footer image {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #eeeeee;
  border-radius: 100rpx;
  background: #999999;
  margin-right: -20rpx;
}

.retail_list_right_footer image:nth-of-type(1) {
  position: relative;
  z-index: 3;
}

.retail_list_right_footer image:nth-of-type(2) {
  position: relative;
  z-index: 2;
}

.retail_list_right_footer image:nth-of-type(3) {
  position: relative;
  z-index: 1;
}
