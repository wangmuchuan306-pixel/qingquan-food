/* component/buygoods/buygoods.wxss */
.tjdd {
  width: 100%;
  height: 100rpx;
  background-color: #015637;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  line-height: 100rpx;
  margin-top: 40rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
}
.yjt {
  width: 16rpx;
  height: 30rpx;
}
.money {
  color: #030;
  font-size: 30rpx;
}
.fbt {
  font-size: 26rpx;
  text-align: left;
  margin: 20rpx 0;
  color: #999;
}
.tx {
  height: 160rpx;
  width: 160rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 20rpx;
}
.buybox {
  width: 100rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background-color: #015637;
  font-size: 24rpx;
  color: white;
  text-align: center;
  line-height: 50rpx;
  font-weight: bold;
}
.flex1 {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex2 {
  display: flex;
  align-items: center;
}
.flex3 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.txt1 {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
.twolinetext{
  overflow:hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}