.body{
    width: 100%;
    padding: 20rpx;
    box-sizing: border-box;
}
.item_box{
    flex: 1;
    min-width: 0;
    background-color: #fff;
    border-radius: 20rpx;
    overflow: hidden;
}
.item_img_box{
    position: relative;
    width: 100%;
}
.item_img{
    width: 100%;
    background-color: #999;
}
.item_img_tag{
    position: absolute;
    top: 20rpx;
    right: 20rpx;
    width: 40rpx;
    height: 40rpx;
}
.item_img_tip{
    position: absolute;
    top: 20rpx;
    left: 20rpx;
    padding: 0 16rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    color: #fff;
    font-size: 22rpx;
    font-weight: bold;
    border-radius: 10rpx;
    background-color: #f60;
}
.item_info{
    width: 100%;
    padding: 10rpx 20rpx 20rpx;
    box-sizing: border-box;
}
.item_name{
    font-size: 28rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
}
.item_desc{
    font-size: 22rpx;
    color: #666;
    margin-bottom: 10rpx;
}
.item_price{
    width: 100%;
    height: 40rpx;
    padding: 0 10rpx;
    box-sizing: border-box;
    margin-bottom: 10rpx;
    border-radius: 6rpx;
}
.item_price_icon{
    width: 28rpx;
    height: 28rpx;
    margin-right: 10rpx;
}
.item_price_text{
    font-size: 20rpx;
    flex: 1;
    min-width: 0;
}
.item_price_right{
    width: 12rpx;
    height: 22rpx;
    margin-left: 10rpx;
}
.item_count{
    width: 100%;
}
.item_count_text{
    font-size: 30rpx;
    font-weight: bold;
    color: #003B73;
}
.item_count_add{
    width: 50rpx;
    height: 50rpx;
}



.flex_center{
    display: flex;
    align-items: center;
    justify-content: center;
}
.flex_align{
    display: flex;
    align-items: center;
}
.flex_sb{
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.txt1 {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.txt2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}