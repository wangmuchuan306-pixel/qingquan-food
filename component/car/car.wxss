/* 商品 */
.commodityItem{
  display: flex;
  position: relative;
  /* padding: 10rpx 24rpx 20rpx 30rpx; */
  box-sizing: border-box;
 
  transition: all .5s;
  padding-right: 30rpx;
 }
 /* 选择按钮 */
 .selectedBtn{
  display: flex;
  align-items: center;
  width: 80rpx;
 }
 .noSelected{
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1px solid #ffffff;
 }
 .selectedBtn .selectedImg{
  width: 44rpx;
  height: 44rpx;
  /* border: 1px solid #ffffff; */
  border-radius: 50%;
  background: #fff;
 }
 /* 商品信息 */
 .commodityInfo{
  display: flex;
  width: calc(100% - 80rpx);
  margin-top: 20rpx;
 }
 .commodityImg{
  margin-right: 18rpx;
  width: 182rpx;
  height: 182rpx;
 }
 .commodityImg image{
  width: 100%;
  height: 100%;
  vertical-align: middle; 
  border-radius: 16rpx;
 }
 /* 商品title */
 .commodityTitle{
  width: calc(100% - 200rpx);
 }
 .title{
  display: -webkit-box;
  width: 100%;
  height: 70rpx;
  line-height:35rpx;
  font-size: 24rpx;
  font-weight:600;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
 }
 .standard{
  padding-top: 16rpx;
  width: 100%;
  height: 60rpx;
  box-sizing: border-box;
  color: #999999;
  font-size: 24rpx;
 }
 .count{
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 60rpx;
 }
  
 /* 删除按钮 */
 .deleteBtn{
  display: flex;
  position: absolute;
  width: 70px;
  height: 100%;
  top: 0rpx;
  right: -70px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ef5225;
 }
 .deleteImg{
  margin-bottom: 10rpx;
  width: 46rpx;
  height: 46rpx;
  vertical-align: middle;
 }
 .deleteText{
  color: #fff;
 }

 .price{
  color: #ff6600;
}