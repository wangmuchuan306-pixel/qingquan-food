.shuaxin2 {
  position: fixed;
  width: 100vw;
  height: 114rpx;
  background-color: #003B73;
  z-index: 999;
  bottom: 100%;
  padding-top: 1000rpx;
}
.flex1 {
  display: flex;
  align-items: center;
  justify-content: center;
}

.shuaxin2 view {
  width: 20rpx;
  height: 20rpx;
  border-radius: 30rpx;
  border-radius: 100%;
  background-color: #f8f8f8;
}

.imageani2_1 {
  animation: imagea2_1 1s infinite ease-in-out;
  background-color: #f8f8f8;
}

@keyframes imagea2_1 {

  0%,
  100% {
    transform: translateY(10rpx);
  }

  50% {
    transform: translateY(-10rpx);
  }
}

.imageani2_2 {
  animation: imagea2_2 1s infinite ease-in-out;
  background-color: #ccc;
}

@keyframes imagea2_2 {

  0%,
  100% {
    transform: translateY(-10rpx);
  }

  50% {
    transform: translateY(10rpx);
  }
}

