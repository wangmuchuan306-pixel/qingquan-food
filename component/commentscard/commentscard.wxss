@charset "UTF-8";
/* component/commentscard/commentscard.wxss */
/* 循环列表样式 */
.goods_box[data-theme='light'] {
  background-color: #fff;
}

.goods_box[data-theme='dark'] {
  background-color: #1C1926;
}

.bottom_nav_left[data-theme='light'] {
  background-color: #eee;
}

.bottom_nav_left[data-theme='dark'] {
  background-color: #1C1A28;
}

.tab_list[data-theme='light'] {
  border-bottom: 2rpx solid #eee;
}

.tab_list[data-theme='dark'] {
  border-bottom: 2rpx solid #1A1D28;
}

.list_content[data-theme='light'] {
  color: #333;
}

.list_content[data-theme='dark'] {
  color: #cbcbcb;
}

.goods_box_center view:nth-of-type(1)[data-theme='light'] {
  color: #333;
}

.goods_box_center view:nth-of-type(1)[data-theme='dark'] {
  color: #ccc;
}

.tab_list {
  width: 690rpx;
  margin: 0 30rpx;
  padding: 60rpx 0;
}

.tab_list:nth-last-of-type(3) {
  border: none;
}

.tab_list_header {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}

.xingbiao {
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  left: 62rpx;
  top: 62rpx;
  background: #ffffff;
  border-radius: 100rpx;
}

.list_headimg {
  width: 90rpx;
  height: 90rpx;
  margin-right: 20rpx;
  border-radius: 100rpx;
  background: #999;
  border: 4rpx solid #fff;
}

.tab_list_header_right {
  width: 84%;
  display: flex;
  align-items: top;
  justify-content: space-between;
}

.tab_list_name {
  display: flex;
  align-items: center;
  /* margin-bottom: 10rpx; */
  justify-content: space-between;
}

.tab_list_name_name {
  font-size: 30rpx;
  /* width:260rpx; */
  display: flex;
  align-items: center;
  /* overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; */
}

.oneline {
  display: inline-block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

.tab_list_name image {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}

.tab_list_name_guanxi {
  background: #ffffff;
  font-size: 20rpx;
  color: #333333;
  background: #ffffff;
  margin-left: 10rpx;
  border-radius: 4rpx;
  padding: 0 4rpx;
}

.tab_list_header_right_dianz {
  color: #75787D;
  font-size: 24rpx;
  text-align: right;
  display: flex;
  align-items: center;
}

.tab_list_header_right_dianz image {
  width: 40rpx;
  height: 40rpx;
  margin-left: 15rpx;
}

.list_content {
  width: 100%;
  font-size: 30rpx;
  height: auto;
  line-height: 46rpx;
  color: #cbcbcb;
}

.question_info {
  /* max-height: 100rpx;
  overflow: hidden; */
  margin-bottom: 20rpx;
}

.yincang {
  color: #cbcbcb;
  word-break: break-all;
  /* 数字和英文字符超出换行 */
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  word-wrap: break-word;
  white-space: normal !important;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 30rpx;
}

.isopen {
  font-size: 30rpx;
  color: #3E90FF;
  line-height: 50rpx;
  padding-bottom: 30rpx;
  /* margin-bottom: 30rpx; */
}

/* 评分部分 */
.grade {
  width: 46%;
  /* margin-top: 10rpx; */
  position: relative;
  overflow: hidden;
}

.grade image {
  width: 100%;
  position: absolute;
  top: -11rpx;
  left: -16rpx;
}

/* 图片展示部分 */
.list_images {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
}

.moreimage {
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}

.moreimage:nth-of-type(3) {
  margin-right: 0rpx;
}

.moreimage:nth-of-type(4) {
  margin-bottom: 0rpx;
}

.moreimage:nth-of-type(5) {
  margin-bottom: 0rpx;
}

.moreimage:nth-of-type(6) {
  margin-bottom: 0rpx;
  margin-right: 0rpx;
}

.video1 {
  width: 370rpx;
  height: 320rpx;
  border-radius: 10rpx;
}

/* 商品及评论 */
.goods_box {
  border-radius: 20rpx 60rpx 60rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  margin-top: 30rpx;
}

.goods_box_center {
  width: 61%;
  margin-left: 15rpx;
  margin-bottom: 10rpx;
}

.goods_box_center view:nth-of-type(1) {
  width: 100%;
  font-size: 30rpx;
  /* color: #FDE1C3; */
  color: #ccc;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  margin-bottom: 10rpx;
}

.goods_box_center view:nth-of-type(2) {
  width: 100%;
  font-size: 24rpx;
  /* color: #8B8D99; */
  color: #999;
  display: flex;
  align-items: center;
}

.content_ {
  max-width: 50%;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  float: left;
  align-items: center;
}

.goods_box_end {
  width: 120rpx;
  height: 54rpx;
  text-align: center;
  line-height: 54rpx;
  color: #fff;
  background: #ff6600;
  font-size: 26rpx;
  border-radius: 100rpx;
  margin-left: 20rpx;
  margin-right: 10rpx;
}

.tab_list_name_bottom {
  display: inline-block;
  background: rgba(231, 199, 179, 0.12);
  border-radius: 10rpx;
  color: #FEE1C3;
  font-size: 26rpx;
  padding: 10rpx 15rpx;
  /* display: flex; */
  align-items: center;
}

.tab_list_name_bottom_left {
  /* display: block; */
  max-width: 500rpx;
  float: left;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

/* 底部导航栏 */
.bottom_nav {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}

.bottom_nav_left {
  position: relative;
  width: 35%;
  height: 58rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #76787E;
  display: flex;
  align-items: center;
}

.touxiang {
  width: 40rpx;
  height: 40rpx;
  border-radius: 100rpx;
  border: 2rpx solid #FFF;
  margin: 0 10rpx 0 8rpx;
}

.bottom_nav_right {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 63%;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

button::after {
  border: none;
}

.nav_list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999999;
  line-height: 40rpx;
  margin-left: 24rpx;
}

.nav_list image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}
